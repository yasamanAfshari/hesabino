<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><% title = 'داشبورد' %></title>
  <style>
    @media (max-width: 576px) {
      #myChart {
        width: 400px !important;
      }
    }
  </style>

</head>

<body class="bg-main-color overflow-hidden">

  <%- include('partials/header', { showPeriodFilter: true, pageTitle: 'داشبورد' }) %>

  <section class="scrollbar overflow-y-auto px-6 pb-6">

    <!-- دستیار هوشمند مالی -->
    <div class="rounded-xl p-3 mb-2 relative overflow-hidden" style="background: linear-gradient(135deg, var(--color-main-color), var(--color-main-color-hover));">
      <div class="relative z-10">
        <div class="flex items-center justify-between flex-wrap gap-3 mb-4">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-xl bg-white/15 flex items-center justify-center shrink-0">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2L14.39 8.26L21 9.27L16.5 13.97L17.77 20.5L12 17.27L6.23 20.5L7.5 13.97L3 9.27L9.61 8.26L12 2Z" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
            <div>
              <h2 class="text-[var(--color-on-accent)] font-bold text-lg">دستیار هوشمند مالی</h2>
            </div>
          </div>
          <button
            type="button"
            id="ai-insight-refresh-btn"
            class="flex items-center gap-1.5 text-[var(--color-on-accent)] !text-xs bg-white/10 hover:bg-white/20 px-3 py-1 rounded-full transition shrink-0"
            title="دریافت تحلیل هوشمند تازه"
          >
            <span id="ai-insight-updated-text">به‌روزرسانی: —</span>
            <svg id="ai-insight-refresh-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12a9 9 0 1 1-2.64-6.36" />
              <path d="M21 4v5h-5" />
            </svg>
          </button>
        </div>

        <div class="flex flex-col md:flex-row gap-3">
          <div class="flex-1 bg-white/95 rounded-xl p-3 flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-amber-100 flex items-center justify-center shrink-0">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M9 18H15M10 21H14M12 3C8.5 3 6 5.6 6 9C6 11.2 7 12.6 8 13.6C8.6 14.2 9 14.9 9 15.7V16H15V15.7C15 14.9 15.4 14.2 16 13.6C17 12.6 18 11.2 18 9C18 5.6 15.5 3 12 3Z" stroke="#D97706" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
            <p class="text-zinc-700 !text-sm leading-relaxed" id="hero-insight-behavior">در حال بارگذاری تحلیل...</p>
          </div>
          <div class="flex-1 bg-white/95 rounded-xl p-3 flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-blue-100 flex items-center justify-center shrink-0">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M3 17L9 11L13 15L21 7M21 7H15M21 7V13" stroke="#1D4ED8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
            <p class="text-zinc-700 !text-sm leading-relaxed" id="hero-insight-prediction">در حال محاسبه پیش‌بینی...</p>
          </div>
        </div>

        <!-- چت با دستیار هوشمند مالی -->
        <div class="bg-white/95 rounded-xl p-3 mt-3">
          <form id="aiAskForm" class="flex items-center gap-2">
            <input
              id="aiAskInput"
              type="text"
              maxlength="400"
              placeholder="از دستیار هوشمند مالی بپرس، مثلاً: وضعیت بودجه‌ی من چطوره؟"
              class="flex-1 border border-gray-200 rounded-lg p-2 !text-sm"
            />
            <button type="submit" id="aiAskButton" class="main-btn !text-sm px-4 py-2 rounded-lg shrink-0">بپرس</button>
          </form>
          <div id="aiAskAnswer" class="hidden mt-3 text-zinc-700 !text-sm leading-relaxed bg-main-color-25 rounded-lg p-3"></div>
        </div>
      </div>
    </div>

    <!-- row 1 -->
    <div class="overflow-x-auto scrollbar py-2">
      <div class="grid grid-cols-6 gap-4 min-w-max">
        <div class="main-box-small dashboard-status">
          <div class="flex justify-between">
            <div class="w-16 h-16 bg-main-color-25 p-2 flex justify-center items-center rounded-lg border border-main-color">
              <svg width="28" height="28" viewBox="0 0 24 23" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M8.4165 13.7328C8.4165 14.969 9.37736 15.9657 10.5712 15.9657H13.0073C14.0458 15.9657 14.8902 15.0936 14.8902 14.0203C14.8902 12.8511 14.3758 12.439 13.609 12.1707L9.69765 10.829C8.9309 10.5607 8.4165 10.1486 8.4165 8.97943C8.4165 7.90609 9.26089 7.03401 10.2994 7.03401H12.7355C13.9293 7.03401 14.8902 8.03068 14.8902 9.26693" stroke="var(--color-main-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M11.6467 5.75V17.25" stroke="var(--color-main-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M14.5585 21.0833H8.73511C3.88229 21.0833 1.94116 19.1667 1.94116 14.375V8.625C1.94116 3.83334 3.88229 1.91667 8.73511 1.91667H14.5585C19.4113 1.91667 21.3524 3.83334 21.3524 8.625V14.375C21.3524 19.1667 19.4113 21.0833 14.5585 21.0833Z" stroke="var(--color-main-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>

            <div class="trend flex justify-center items-center px-1.5">
              <span id="stat-accounts-count">—</span>
            </div>
          </div>
          <div class="text-zinc-700 !text-lg my-2.5">موجودی کل</div>
          <div class="text-zinc-700 !text-xl font-bold text-center my-2.5" id="stat-balance">—</div>
        </div>

        <div class="main-box-small dashboard-status">
          <div class="flex justify-between">
            <div class="w-16 h-16 bg-green-color-25 p-2 flex justify-center items-center rounded-lg border border-green-color">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M9.16211 13.2609C9.16211 14.1964 9.88544 14.9486 10.7727 14.9486H12.5858C13.3574 14.9486 13.9843 14.2928 13.9843 13.4731C13.9843 12.5954 13.5985 12.2772 13.0295 12.0747L10.1265 11.062C9.55753 10.8595 9.17176 10.5509 9.17176 9.66358C9.17176 8.85346 9.79862 8.188 10.5702 8.188H12.3833C13.2706 8.188 13.9939 8.94026 13.9939 9.87575" stroke="var(--color-green-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M11.5732 7.23322V15.9131" stroke="var(--color-green-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M21.2175 11.5732C21.2175 16.8968 16.8969 21.2174 11.5732 21.2174C6.2496 21.2174 1.92896 16.8968 1.92896 11.5732C1.92896 6.24951 6.2496 1.92886 11.5732 1.92886" stroke="var(--color-green-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M16.3953 2.89328V6.751H20.253" stroke="var(--color-green-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M21.2174 1.92886L16.3953 6.75101" stroke="var(--color-green-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>

            </div>

            <div class="trend-p flex justify-center items-center px-1.5" id="stat-income-trend">
              <span>—</span>
            </div>
          </div>
          <div class="text-zinc-700 !text-lg my-2.5" id="stat-income-label">درآمد ماه</div>
          <div class="text-zinc-700 !text-xl font-bold text-center my-2.5" id="stat-income">—</div>
          <p class="result-status text-zinc-400 text-center" id="stat-income-subtitle">—</p>
        </div>

        <div class="main-box-small dashboard-status">
          <div class="flex justify-between">
            <div class="w-16 h-16 bg-red-color-25 p-2 flex justify-center items-center rounded-lg border border-red-color">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M9.16211 13.2609C9.16211 14.1964 9.88544 14.9486 10.7727 14.9486H12.5858C13.3574 14.9486 13.9843 14.2928 13.9843 13.4731C13.9843 12.5954 13.5985 12.2772 13.0295 12.0747L10.1265 11.062C9.55753 10.8595 9.17176 10.5509 9.17176 9.66358C9.17176 8.85346 9.79862 8.188 10.5702 8.188H12.3833C13.2706 8.188 13.9939 8.94026 13.9939 9.87575" stroke="var(--color-red-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M11.5732 7.23322V15.9131" stroke="var(--color-red-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M21.2175 11.5732C21.2175 16.8968 16.8969 21.2174 11.5732 21.2174C6.2496 21.2174 1.92896 16.8968 1.92896 11.5732C1.92896 6.24951 6.2496 1.92886 11.5732 1.92886" stroke="var(--color-red-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M21.2173 5.78658V1.92886H17.3596" stroke="var(--color-red-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M16.3953 6.75101L21.2174 1.92886" stroke="var(--color-red-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>

            <div class="trend-m flex justify-center items-center px-1.5" id="stat-expense-trend">
              <span>—</span>
            </div>
          </div>
          <div class="text-zinc-700 !text-lg my-2.5" id="stat-expense-label">هزینه های ماه</div>
          <div class="text-zinc-700 !text-xl font-bold text-center my-2.5" id="stat-expense">—</div>
          <p class="result-status text-zinc-400 text-center" id="stat-expense-subtitle">—</p>

        </div>

        <div class="main-box-small dashboard-status">
          <div class="flex justify-between">
            <div class="w-16 h-16 bg-orange-color-25 p-2 flex justify-center items-center rounded-lg border border-orange-color">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M6.49059 18.9993C7.28143 18.1506 8.48696 18.2181 9.18135 19.1439L10.1554 20.4459C10.9366 21.4778 12.2 21.4778 12.9812 20.4459L13.9553 19.1439C14.6497 18.2181 15.8552 18.1506 16.646 18.9993C18.3627 20.8317 19.7611 20.2241 19.7611 17.6587V6.78959C19.7708 2.90294 18.8642 1.92886 15.2187 1.92886H7.92759C4.28205 1.92886 3.37549 2.90294 3.37549 6.78959V17.6491C3.37549 20.2241 4.78355 20.822 6.49059 18.9993Z" stroke="var(--color-orange-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M7.71533 6.75101H15.4308" stroke="var(--color-orange-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M8.67993 10.6087H14.4665" stroke="var(--color-orange-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>

            <div class="trend flex justify-center items-center px-1.5">
              <span id="stat-cheques-count">—</span>
            </div>
          </div>
          <div class="text-zinc-700 !text-lg my-2.5">چک نزدیک</div>
          <div class="text-zinc-700 !text-xl font-bold text-center my-2.5" id="stat-cheques-amount">—</div>
          <p class="result-status text-zinc-400 text-center" id="stat-cheques-subtitle">—</p>

        </div>

        <div class="main-box-small dashboard-status">
          <div class="flex justify-between">
            <div class="w-16 h-16 bg-purple-color-25 p-2 flex justify-center items-center rounded-lg border border-purple-color">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M11.5732 21.2174C16.8996 21.2174 21.2175 16.8995 21.2175 11.5732C21.2175 6.24676 16.8996 1.92886 11.5732 1.92886C6.24685 1.92886 1.92896 6.24676 1.92896 11.5732C1.92896 16.8995 6.24685 21.2174 11.5732 21.2174Z" stroke="var(--color-purple-color)" />
                <path d="M11.5732 17.3597C14.769 17.3597 17.3598 14.769 17.3598 11.5732C17.3598 8.37731 14.769 5.78658 11.5732 5.78658C8.37736 5.78658 5.78662 8.37731 5.78662 11.5732C5.78662 14.769 8.37736 17.3597 11.5732 17.3597Z" stroke="var(--color-purple-color)" />
                <path d="M11.5731 13.502C12.6384 13.502 13.502 12.6384 13.502 11.5731C13.502 10.5079 12.6384 9.64429 11.5731 9.64429C10.5079 9.64429 9.64429 10.5079 9.64429 11.5731C9.64429 12.6384 10.5079 13.502 11.5731 13.502Z" stroke="var(--color-purple-color)" />
              </svg>
            </div>

            <div class="trend flex justify-center items-center px-1.5" id="stat-savings-trend">
              <span>—</span>
            </div>
          </div>
          <div class="text-zinc-700 !text-lg my-2.5">نرخ پس انداز</div>
          <div class="text-zinc-700 !text-xl font-bold text-center my-2.5" id="stat-savings-rate">—</div>
          <p class="result-status text-zinc-400 text-center">از کل درآمد</p>

        </div>

        <div class="main-box-small dashboard-status">
          <div class="flex justify-between">
            <div class="w-16 h-16 bg-green2-color-25 p-2 flex justify-center items-center rounded-lg border border-green2-color">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M21.2174 10.6859V11.5732C21.2162 13.6529 20.5428 15.6765 19.2976 17.3422C18.0523 19.0079 16.302 20.2265 14.3076 20.8161C12.3133 21.4058 10.1817 21.335 8.23087 20.6143C6.28003 19.8935 4.61443 18.5615 3.48249 16.8168C2.35055 15.0721 1.8129 13.0083 1.94974 10.9331C2.08658 8.85786 2.89057 6.88248 4.2418 5.30154C5.59304 3.7206 7.41912 2.6188 9.4477 2.16046C11.4763 1.70213 13.5987 1.91183 15.4984 2.75827" stroke="var(--color-green2-color)" stroke-width="1.5" />
                <path d="M21.2174 3.85771L11.5731 13.5116L8.67981 10.6184" stroke="var(--color-green2-color)" stroke-width="1.5" />
              </svg>
            </div>

            <div class="trend flex justify-center items-center px-1.5">
              <span id="stat-health-score">—</span>
            </div>
          </div>
          <div class="text-zinc-700 !text-lg my-2.5">سلامت مالی</div>
          <div class="text-zinc-700 !text-xl font-bold text-center my-2.5" id="stat-health-label">—</div>
          <p class="result-status text-zinc-400 text-center">بر اساس ۶ عامل مالی</p>

        </div>
      </div>
    </div>

    <!-- row 2 -->
    <div class="grid grid-cols-1 xl:grid-cols-2 mt-3 gap-4">
      <div class="main-box-small">
        <div class="flex items-center justify-between mb-6 border-b border-gray-200 pb-3 flex-wrap gap-2">
          <div class="flex items-center gap-3">
            <h2 class="font-bold text-lg text-zinc-800" id="category-chart-title">هزینه به تفکیک دسته</h2>
          </div>
        </div>
        <div>
          <div class="grid md:grid-cols-2 grid-cols-1">
            <!-- legend -->
            <div id="category-legend-list" class="space-y-2">
              <p class="text-zinc-400 !text-sm">در حال بارگذاری...</p>
            </div>

            <!-- chart -->
            <div class="flex justify-center items-center">
              <div class="md:w-[200px] md:h-[200px] w-[150px] h-[150px]">
                <canvas id="donutChart" class="w-[200px] h-[200px]"></canvas>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="main-box-small overflow-auto scrollbar">
        <div class="flex items-center justify-between mb-6 border-b border-gray-200 pb-3 flex-wrap gap-2">
          <div class="flex items-center gap-3">
            <h2 class="font-bold text-lg text-zinc-800">جریان مالی (۶ ماه اخیر)</h2>
          </div>
        </div>
        <div class="flex justify-center">
          <div class="h-[280px] w-[580px]">
            <canvas id="myChart" width="800" height="400"></canvas>
          </div>
        </div>
      </div>

    </div>

    <!-- row 3 -->
    <div class="grid grid-cols-3 lg:grid-cols-6 gap-4 mt-3">
      <div class="col-span-3">
        <div class="main-box-small h-[stretch]">
          <div class="flex items-center justify-between mb-6 border-b border-gray-200 pb-3 flex-wrap gap-2">
            <div class="flex items-center gap-3">
              <h2 class="font-bold text-lg text-zinc-800">نسبت هزینه به درآمد</h2>
            </div>
          </div>

          <div class="overflow-x-auto scrollbar min-h-[100px]">
            <div id="expenseChart" class="flex flex-row-reverse gap-4 min-w-max w-full">
              <p class="text-zinc-400 !text-sm">در حال بارگذاری...</p>
            </div>
          </div>
        </div>
      </div>

      <div class="col-span-1">
        <div class="main-box-small flex flex-col h-[225px] md:h-[stretch]">
          <div class="flex items-center justify-between mb-6 border-b border-gray-200 pb-3 flex-wrap gap-2">
            <div class="flex items-center gap-3">
              <h2 class="font-bold text-lg text-zinc-800">تراز ماه جاری</h2>
            </div>
          </div>
          <div class="flex-1 flex items-center justify-center font-bold" id="stat-monthly-balance">
            <span class="!text-2xl">—</span>
          </div>
        </div>
      </div>

      <div class="col-span-2">
        <div class="main-box-small h-[stretch]">
          <div class="flex justify-between">
            <div class="flex items-center justify-between mb-6 border-b border-gray-200 pb-3 flex-wrap gap-2 w-full">
              <div class="flex items-center gap-3">
                <h2 class="font-bold text-lg text-zinc-800">نزدیک ترین پس انداز</h2>
              </div>
              <a href="/savings" class="flex text-main-color">
                همه
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M7.1775 4.44751L2.625 9.00001L7.1775 13.5525" stroke="var(--color-main-color)" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round" />
                  <path d="M15.3749 9H2.75244" stroke="var(--color-main-color)" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </div>
          </div>

          <div class="progress-wrapper text-end mt-5" id="closest-goal-wrapper">
            <p class="!text-sm text-zinc-600 mb-2 text-start" id="closest-goal-name"></p>
            <span class="percent font-bold" id="closest-goal-percent">0%</span>
            <div class="bar-bg">
              <div class="bar-fill" id="closest-goal-bar"></div>
            </div>
            <div class="flex justify-between mt-3">
              <p>پس انداز شده:
                <span id="closest-goal-saved">—</span>
              </p>

              <p>هدف:
                <span id="closest-goal-target">—</span>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- row 4 -->
    <div class="grid grid-cols-1 xl:grid-cols-1 mt-3 gap-4">
      <div class="main-box-small">
        <div class="flex items-center justify-between mb-6 border-b border-gray-200 pb-3 flex-wrap gap-2">
          <div class="flex items-center gap-3">
            <h2 class="font-bold text-lg text-zinc-800">هشدارهای مالی</h2>
          </div>

        </div>

        <div class="scrollbar flex flex-nowrap overflow-x-auto pb-4 gap-5 rounded-2xl" id="budget-alerts-container">
          <p class="text-zinc-400 !text-sm p-2">در حال بارگذاری هشدارها...</p>
        </div>
      </div>
    </div>

    <!-- row دارایی‌ها / اشتراک‌ها / اقساط -->
    <div class="grid grid-cols-1 lg:grid-cols-3 mt-3 gap-4">

      <!-- دارایی‌ها -->
      <div class="main-box-small">
        <div class="flex items-center justify-between mb-4 border-b border-gray-200 pb-3">
          <h2 class="font-bold text-lg text-zinc-800">دارایی‌ها</h2>
          <button onclick="openAssetAddModal()" class="flex items-center gap-1 text-main-color !text-sm">
            + افزودن
          </button>
        </div>
        <p class="text-zinc-400 !text-xs mb-1">ارزش کل دارایی‌ها</p>
