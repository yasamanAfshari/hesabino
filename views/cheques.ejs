<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    <% title = 'مدیریت چک ها' %>
  </title>
  <style>
    .main-box {
      height: 64vh !important;
    }
  </style>
</head>

<body class="bg-main-color overflow-hidden">

    <%- include('partials/header' , { pageTitle: 'مدیریت چک ها' } ) %>

  <section class="scrollbar overflow-y-auto px-6 pb-1">

    <div class="overflow-x-auto scrollbar">
      <div class="grid grid-cols-4 gap-4 min-w-max">
        <div class="main-box-small dashboard-status">
          <div class="flex justify-start gap-4">
            <div class="w-16 h-16 bg-main-color-25 p-2 flex justify-center items-center rounded-lg border border-main-color">
              <svg width="39" height="39" viewBox="0 0 39 39" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M31.6875 20.3125C31.6875 18.07 33.5075 16.25 35.75 16.25V14.625C35.75 8.125 34.125 6.5 27.625 6.5H11.375C4.875 6.5 3.25 8.125 3.25 14.625V15.4375C5.4925 15.4375 7.3125 17.2575 7.3125 19.5C7.3125 21.7425 5.4925 23.5625 3.25 23.5625V24.375C3.25 30.875 4.875 32.5 11.375 32.5H27.625C34.125 32.5 35.75 30.875 35.75 24.375C33.5075 24.375 31.6875 22.555 31.6875 20.3125Z" stroke="var(--color-main-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M16.25 6.5L16.25 32.5" stroke="var(--color-main-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="5 5" />
              </svg>
            </div>
            <div>
              <div class="text-zinc-700 font-bold !text-lg">کل چک ها</div>
              <div id="chequesTotalCount" class="text-zinc-500 !text-md text-start my-2.5">۰ عدد</div>
            </div>
          </div>
        </div>

        <div class="main-box-small dashboard-status">
          <div class="flex justify-start gap-4">
            <div class="w-16 h-16 bg-green-color-25 p-2 flex justify-center items-center rounded-lg border border-green-color">
              <svg width="39" height="39" viewBox="0 0 39 39" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M19.5 35.75C28.4375 35.75 35.75 28.4375 35.75 19.5C35.75 10.5625 28.4375 3.25 19.5 3.25C10.5625 3.25 3.25 10.5625 3.25 19.5C3.25 28.4375 10.5625 35.75 19.5 35.75Z" stroke="var(--color-green-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M12.5938 19.5L17.1925 24.0987L26.4062 14.9012" stroke="var(--color-green-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
            <div>
              <div class="text-zinc-700 font-bold !text-lg">وصول شده</div>
              <div id="chequesCashedCount" class="text-zinc-500 !text-md text-start my-2.5">۰ عدد</div>
            </div>
          </div>
        </div>

        <div class="main-box-small dashboard-status">
          <div class="flex justify-start gap-4">
            <div class="w-16 h-16 bg-red-color-25 p-2 flex justify-center items-center rounded-lg border border-red-color">
              <svg width="39" height="39" viewBox="0 0 39 39" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M17.7168 32.2889H28.2305C34.243 32.2889 35.738 30.7939 35.738 24.7814C33.658 24.7814 31.9843 23.0914 31.9843 21.0276C31.9843 18.9476 33.658 17.2576 35.738 17.2576V15.7626C35.738 9.75013 34.243 8.25513 28.2305 8.25513H17.863V19.2889" stroke="var(--color-red-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M17.8645 27.4137V32.2887H13.3633C10.9583 32.2887 9.54454 30.6475 7.98454 26.8775L7.69204 26.1462C9.65829 25.3662 10.617 23.0913 9.78829 21.125C8.99204 19.1587 6.73329 18.2163 4.75079 19.0288L4.47454 18.33C2.13454 12.61 2.94704 10.6112 8.66704 8.255L12.957 6.5L17.8645 18.395V22.5387" stroke="var(--color-red-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M13.2636 32.2889H12.9873" stroke="var(--color-red-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
            <div>
              <div class="text-zinc-700 font-bold !text-lg">برگشت خورده</div>
              <div id="chequesBouncedCount" class="text-zinc-500 !text-md text-start my-2.5">۰ عدد</div>
            </div>
          </div>
        </div>

        <div class="main-box-small dashboard-status">
          <div class="flex justify-start gap-4">
            <div class="w-16 h-16 bg-orange-color-25 p-2 flex justify-center items-center rounded-lg border border-orange-color">
              <svg width="39" height="39" viewBox="0 0 39 39" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M24.7647 3.25H14.2347C8.1247 3.25 7.65345 8.7425 10.9522 11.7325L28.0472 27.2675C31.3459 30.2575 30.8747 35.75 24.7647 35.75H14.2347C8.1247 35.75 7.65345 30.2575 10.9522 27.2675L28.0472 11.7325C31.3459 8.7425 30.8747 3.25 24.7647 3.25Z" stroke="var(--color-orange-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
            <div>
              <div class="text-zinc-700 font-bold !text-lg">در انتظار</div>
              <div id="chequesPendingCount" class="text-zinc-500 !text-md text-start my-2.5">۰ عدد</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 my-2">
      <div class="main-box">
        <div class="flex items-center justify-between mb-1 border-b border-gray-200 pb-3 flex-wrap gap-2">
          <div class="flex items-center gap-3 w-full justify-between">
            <h2 class="font-bold text-lg text-zinc-800">لیست چک ها</h2>
            <div class="flex items-center gap-3">
              <button class="main-btn" onclick="ChequesApp.openAddModal()">ثبت چک جدید</button>
              <button class="bg-yellow-500 p-1 rounded-md w-10 flex justify-center" onclick="ChequesApp.openAlertsModal()">
                <svg width="26" height="26" viewBox="0 0 26 26" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M13.0216 3.1525C9.43581 3.1525 6.52164 6.06666 6.52164 9.6525V12.7833C6.52164 13.4442 6.23997 14.4517 5.90414 15.015L4.65831 17.0842C3.88914 18.3625 4.41997 19.7817 5.82831 20.2583C10.4975 21.8183 15.535 21.8183 20.2041 20.2583C21.515 19.825 22.0891 18.2758 21.3741 17.0842L20.1283 15.015C19.8033 14.4517 19.5216 13.4442 19.5216 12.7833V9.6525C19.5216 6.0775 16.5966 3.1525 13.0216 3.1525Z" stroke="white" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" />
                  <path d="M15.0259 3.46665C14.6901 3.36915 14.3434 3.29332 13.9859 3.24999C12.9459 3.11999 11.9492 3.19582 11.0176 3.46665C11.3317 2.66499 12.1117 2.10165 13.0217 2.10165C13.9317 2.10165 14.7117 2.66499 15.0259 3.46665Z" stroke="white" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round" />
                  <path d="M16.2715 20.6483C16.2715 22.4358 14.809 23.8983 13.0215 23.8983C12.1332 23.8983 11.3098 23.53 10.7248 22.945C10.1398 22.36 9.77148 21.5367 9.77148 20.6483" stroke="white" stroke-width="1.5" stroke-miterlimit="10" />
                </svg>
              </button>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 py-4">
          <!-- Search -->
          <div class="relative">
            <input type="text" id="filterSearchInput" placeholder="جست و جو" class="w-full h-10 border border-main-color rounded-lg pr-4 pl-4 outline-none">
            <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-6 h-6 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m20 20-3.5-3.5"></path>
            </svg>
          </div>

          <!-- نوع چک -->
          <div id="filterTypeSelect" class="custom-select relative">
            <button type="button" class="select-btn w-full h-10 border border-main-color rounded-lg flex items-center justify-between px-4 bg-white">
              <span class="selected-value text-gray-700" data-placeholder="نوع چک *">نوع چک *</span>
              <svg class="w-5 h-5 transition" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </button>
            <div class="dropdown hidden absolute left-0 w-full border border-gray-400 bg-white rounded-lg shadow-lg z-50">
              <div class="p-2 border-b border-main-color-25">
                <input type="text" class="search-input w-full border border-main-color-25 rounded-md px-3 py-2 outline-none" placeholder="جستجو...">
              </div>
              <div class="options max-h-52 overflow-y-auto">
                <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100" data-value="">همه</div>
                <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100" data-value="received">دریافتی</div>
                <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100" data-value="paid">پرداختی</div>
              </div>
            </div>
          </div>

          <!-- وضعیت -->
          <div id="filterStatusSelect" class="custom-select relative">
            <button type="button" class="select-btn w-full h-10 border border-main-color rounded-lg flex items-center justify-between px-4 bg-white">
              <span class="selected-value text-gray-700" data-placeholder="وضعیت">وضعیت</span>
              <svg class="w-5 h-5 transition" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </button>
            <div class="dropdown hidden absolute left-0 w-full border border-gray-400 bg-white rounded-lg shadow-lg z-50">
              <div class="p-2 border-b border-main-color-25">
                <input type="text" class="search-input w-full border border-main-color-25 rounded-md px-3 py-2 outline-none" placeholder="جستجو...">
              </div>
              <div class="options max-h-52 overflow-y-auto">
                <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100" data-value="">همه</div>
                <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100" data-value="pending">در انتظار</div>
                <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100" data-value="cashed">وصول شده</div>
                <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100" data-value="bounced">برگشت خورده</div>
              </div>
            </div>
          </div>

          <!-- تاریخ -->
          <div class="relative">
            <input type="text" id="filterDatePicker" class="date w-full h-10 date-none-txt wt-datepicker-input-element border border-main-color rounded-lg pr-4 pl-4 outline-none pwt-datepicker-input-element" placeholder="تاریخ" autocomplete="off">
            <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-6 h-6 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <rect x="3" y="4" width="18" height="18" rx="2"></rect>
              <path d="M16 2v4M8 2v4M3 10h18"></path>
            </svg>
          </div>

          <div class="col-span-2">
            <div class="flex w-full justify-end">
              <button type="button" onclick="ChequesApp.resetFilter()" class="px-4 py-2 rounded-lg border border-gray-300 text-gray-700">بازنشانی</button>
            </div>
          </div>
        </div>

        <div id="chequesFormError" class="hidden mb-3 rounded-lg px-4 py-2.5 text-sm bg-red-color-25 text-red-color"></div>

        <div class="scrollable-table-container relative scrollbar border-gray-200 border rounded-md">
          <table class="w-full text-sm md:text-base">
            <thead class="bg-blue-50 shadow-sm">
              <tr>
                <th scope="col" class="sticky top-0 z-20 font-semibold text-gray-700 text-sm md:text-base bg-blue-50 backdrop-blur-sm">
                  <div class="flex items-center justify-between gap-2">
                    <span> شماره چک</span>
                  </div>
                </th>
                <th scope="col" class="sticky top-0 z-20 font-semibold text-gray-700 text-sm md:text-base bg-blue-50 backdrop-blur-sm">
                  <div class="flex items-center gap-1.5">
                    <span> نوع</span>
                  </div>
                </th>
                <th scope="col" class="sticky top-0 z-20 font-semibold text-gray-700 text-sm md:text-base bg-blue-50 backdrop-blur-sm">
                  <div class="flex items-center gap-1.5">
                    <span> مبلغ</span>
                  </div>
                </th>
                <th scope="col" class="sticky top-0 z-20 font-semibold text-gray-700 text-sm md:text-base bg-blue-50 backdrop-blur-sm">
                  <div class="flex items-center gap-1.5">
                    <span> طرف حساب</span>
                  </div>
                </th>
                <th scope="col" class="sticky top-0 z-20 font-semibold text-gray-700 text-sm md:text-base bg-blue-50 backdrop-blur-sm">
                  <div class="flex items-center justify-between gap-2">
                    <span>تاریخ</span>
                  </div>
                </th>
                <th scope="col" class="sticky top-0 z-20 font-semibold text-gray-700 text-sm md:text-base bg-blue-50 backdrop-blur-sm">
                  <div class="flex items-center justify-between gap-2">
                    <span> بانک</span>
                  </div>
                </th>
                <th scope="col" class="sticky top-0 z-20 font-semibold text-gray-700 text-sm md:text-base bg-blue-50 backdrop-blur-sm">
                  <div class="flex items-center justify-between gap-2">
                    <span> وضعیت</span>
                  </div>
                </th>
                <th scope="col" class="sticky top-0 z-20 font-semibold text-gray-700 text-sm md:text-base bg-blue-50 backdrop-blur-sm">
                  <div class="flex items-center justify-between gap-2">
                    <span> عملیات</span>
                  </div>
                </th>
              </tr>
            </thead>
            <tbody id="chequesTableBody" class="divide-y divide-gray-100">
              <tr>
                <td colspan="8" class="px-5 py-6 text-center text-gray-400">در حال بارگذاری چک‌ها...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>


  <!-- مودال ثبت/ویرایش چک (مشترک) -->
  <div id="chequeModal" class="modal hidden fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-xl max-w-2xl max-h-[90vh] lg:w-[35vw] w-full flex flex-col relative">
      <!-- هدر ثابت -->
      <div class="flex items-center justify-between px-6 pt-6 pb-3 border-b border-gray-200">
        <h3 id="chequeModalTitle" class="font-bold text-lg text-zinc-800">ثبت چک جدید</h3>
        <button type="button" onclick="closeModal()" class="text-gray-500 hover:text-gray-700">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 6L6 18M6 6l12 12" />
          </svg>
        </button>
      </div>

      <form id="chequeForm" class="flex flex-col flex-1 min-h-0">
        <div class="modal-body overflow-y-auto flex flex-col gap-3 scrollbar px-6 py-4">
          <input type="hidden" id="chequeId" value="">

          <div id="chequeFormError" class="hidden rounded-lg px-4 py-2.5 text-sm bg-red-color-25 text-red-color"></div>

          <div class="relative">
            <input type="text" id="chequeNumberInput" placeholder="شماره چک *" required class="w-full h-10 border border-main-color rounded-lg pr-4 pl-4 outline-none">
          </div>
          <div class="grid grid-cols-2 gap-3">

            <div id="modalTypeSelect" class="custom-select relative">
              <button type="button" class="select-btn w-full h-10 border border-main-color rounded-lg flex items-center justify-between px-4 bg-white">
                <span class="selected-value text-gray-700" data-placeholder="نوع چک">نوع چک</span>
                <svg class="w-5 h-5 transition" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="m6 9 6 6 6-6"></path>
                </svg>
              </button>
              <div class="dropdown hidden absolute left-0 w-full border border-gray-400 bg-white rounded-lg shadow-lg z-50">
                <div class="p-2 border-b border-main-color-25">
                  <input type="text" class="search-input w-full border border-main-color-25 rounded-md px-3 py-2 outline-none" placeholder="جستجو...">
                </div>
                <div class="options max-h-52 overflow-y-auto">
                  <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100" data-value="received">دریافتی</div>
                  <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100" data-value="paid">پرداختی</div>
                </div>
              </div>
            </div>

            <div class="relative">
              <input type="number" min="0" step="1" id="chequeAmountInput" placeholder="مبلغ *" required class="w-full h-10 border border-main-color rounded-lg pr-4 pl-4 outline-none">
            </div>

            <div class="relative">
              <input type="text" id="chequeCounterpartyInput" placeholder="طرف حساب" class="w-full h-10 border border-main-color rounded-lg pr-4 pl-4 outline-none">
            </div>

            <div class="relative">
              <input type="text" id="chequeBankInput" placeholder="نام بانک " class="w-full h-10 border border-main-color rounded-lg pr-4 pl-4 outline-none">
            </div>

            <div class="relative">
              <input type="text" id="chequeDatePicker" required class="date w-full h-10 date-none-txt wt-datepicker-input-element border border-main-color rounded-lg pr-4 pl-4 outline-none" placeholder="تاریخ *" autocomplete="off">
              <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-6 h-6 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                <path d="M16 2v4M8 2v4M3 10h18"></path>
              </svg>
            </div>

            <div id="modalStatusSelect" class="custom-select relative">
              <button type="button" class="select-btn w-full h-10 border border-main-color rounded-lg flex items-center justify-between px-4 bg-white">
                <span class="selected-value text-gray-700" data-placeholder="وضعیت">وضعیت</span>
                <svg class="w-5 h-5 transition" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="m6 9 6 6 6-6"></path>
                </svg>
              </button>
              <div class="dropdown hidden absolute left-0 w-full border border-gray-400 bg-white rounded-lg shadow-lg z-50">
                <div class="p-2 border-b border-main-color-25">
                  <input type="text" class="search-input w-full border border-main-color-25 rounded-md px-3 py-2 outline-none" placeholder="جستجو...">
                </div>
                <div class="options max-h-52 overflow-y-auto">
                  <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100" data-value="pending">در انتظار</div>
                  <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100" data-value="cashed">وصول شده</div>
                  <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100" data-value="bounced">برگشت خورده</div>
                </div>
              </div>
            </div>

            <div>
              <label class="reminder-toggle">
                <input type="checkbox" id="chequeReminderInput">
                <span class="slider-track"></span>
                <span class="toggle-label"> یادآور</span>
              </label>
            </div>
          </div>
        </div>

        <!-- فوتر ثابت -->
        <div class="flex justify-end gap-2 px-6 pb-6 pt-4 border-t border-gray-200">
          <button type="button" onclick="closeModal()" class="px-4 py-2 rounded-lg border border-gray-300 text-gray-700">انصراف</button>
          <button type="submit" id="chequeSubmitBtn" class="main-btn px-4 py-2 rounded-lg">ثبت</button>
        </div>
      </form>
    </div>
  </div>

  <!-- مودال یادآوری‌ها، هشدارها و تحلیل چک‌ها -->
  <div id="chequesAlertsModal" class="modal hidden fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-xl w-full max-w-lg max-h-[85vh] flex flex-col relative">
      <div class="flex items-center justify-between px-6 pt-6 pb-3 border-b border-gray-200">
        <h3 class="font-bold text-lg text-zinc-800">یادآوری‌ها و تحلیل چک‌ها</h3>
        <button onclick="closeModal()" class="text-gray-500 hover:text-gray-700">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 6L6 18M6 6l12 12" />
          </svg>
        </button>
      </div>

      <div class="overflow-y-auto flex-1 scrollbar px-6 py-4" id="chequesAlertsList">
        <p class="text-center text-gray-400 mt-6">در حال بررسی وضعیت چک‌ها...</p>
      </div>

      <div class="flex justify-end px-6 pb-6 pt-4 border-t border-gray-200">
        <button onclick="closeModal()" class="px-4 py-2 rounded-lg border border-gray-300 text-gray-700">بستن</button>
      </div>
    </div>
  </div>

  <script>
    function openModal(id) {
      const modal = document.getElementById(id);
      if (!modal) return;
      modal.classList.remove('hidden');
      requestAnimationFrame(() => {
        requestAnimationFrame(() => modal.classList.add('is-open'));
      });
      document.body.classList.add('overflow-hidden');
    }

    function closeModal() {
      document.querySelectorAll('.modal.is-open').forEach((modal) => {
        modal.classList.remove('is-open');
        setTimeout(() => modal.classList.add('hidden'), 250);
      });
      document.body.classList.remove('overflow-hidden');
    }
  </script>
  <script src="/JS/cheques.js" defer></script>
</body>

</html>
