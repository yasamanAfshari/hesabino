<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><% title = 'تراکنش ها' %></title>
  <style>
    /* گزینه‌های «نوع تراکنش» و «دسته» که متعلق به نوع مالی انتخاب‌نشده هستن مخفی می‌شن */
    #modalSubtypeSelect .option.fintype-hidden,
    #modalCategorySelect .option.fintype-hidden {
      display: none !important;
    }

    /* ===== ناحیه‌ی مخصوص چاپ =====
       این div همیشه توی DOM هست ولی روی صفحه (نه موقع چاپ) با position:fixed و
       آفست منفی از دید کاربر خارجه؛ display:none استفاده نشده چون در اون صورت
       موقع چاپ هم قابل نمایش نمی‌شد (visibility روی فرزندهای display:none اثر نداره) */
    #hbPrintArea {
      visibility: hidden;
      position: fixed;
      top: -99999px;
      left: -99999px;
    }

    @media print {
      /* صفحه‌بندی این اپ با CSS Grid و overflow-hidden + ارتفاع ثابت (h-screen) روی
         #app-grid و main پیاده شده؛ همین‌ها باعث می‌شن یک عنصر position:absolute
         داخلشون (مثل ناحیه‌ی چاپ) به‌جای این‌که آزادانه بین چند صفحه پخش بشه، توی
         ارتفاع یک صفحه‌نمایش کلیپ (بریده) بشه. برای همین موقع چاپ، این محدودیت‌ها
         (فقط موقع چاپ، نه روی صفحه‌ی عادی) خنثی می‌شن.
         نکته: از position:fixed برای ناحیه‌ی چاپ استفاده نشده چون مرورگرها با
         position:fixed توی چاپ چندصفحه‌ای معمولاً یا محتوا رو کات می‌کنن یا توی هر
         صفحه تکرارش می‌کنن؛ position:absolute (نسبت به body، بعد از خنثی‌شدن
         overflow/height والدها) درست بین صفحات پخش و صفحه‌بندی می‌شه. */
      #app-grid,
      main {
        overflow: visible !important;
        height: auto !important;
        position: static !important;
        display: block !important;
      }

      body * {
        visibility: hidden !important;
      }

      #hbPrintArea,
      #hbPrintArea * {
        visibility: visible !important;
      }

      #hbPrintArea {
        position: absolute !important;
        top: 0 !important;
        left: 0 !important;
        width: 100% !important;
        margin: 0;
        padding: 12px;
        direction: rtl;
      }

      #hbPrintArea table {
        width: 100%;
        border-collapse: collapse;
      }

      /* هدر جدول توی هر صفحه‌ی چاپی تکرار بشه؛ و هر ردیف کامل توی یک صفحه بمونه
         (اگه جدول بلندتر از یک صفحه بود، بین ردیف‌ها صفحه عوض می‌شه، نه وسط یک ردیف) */
      #hbPrintArea thead {
        display: table-header-group;
      }

      #hbPrintArea tr {
        page-break-inside: avoid;
      }

      #hbPrintArea th,
      #hbPrintArea td {
        border: 1px solid #999;
        padding: 6px 8px;
        text-align: right;
        font-size: 12px;
      }

      #hbPrintArea .hb-print-title {
        font-size: 16px;
        font-weight: bold;
        margin-bottom: 4px;
      }

      #hbPrintArea .hb-print-meta {
        font-size: 11px;
        color: #555;
        margin-bottom: 12px;
      }
    }
  </style>
</head>

<body class="bg-main-color overflow-hidden">

  <%- include('partials/header' , { pageTitle: 'تراکنش ها', showPeriodFilter: true } ) %>

  <section class="scrollbar overflow-y-auto px-6 pb-1">
    <div class="main-box-small">
      <div class="flex justify-between items-center">
        <div class="">
          <button type="button" class="main-btn" onclick="TransactionsApp.triggerCsvImport()">افزودن csv بانکی</button>
          <button type="button" class="main-btn" onclick="TransactionsApp.printList()">چاپ لیست</button>
          <input type="file" id="csvFileInput" accept=".csv,text/csv" class="hidden" onchange="TransactionsApp.handleCsvFile(this.files[0]); this.value = '';">
        </div>
        <button class="main-btn" onclick="openAddTransactionModal()">ثبت تراکنش</button>
      </div>
    </div>

    <div class="grid grid-cols-1 mt-3">
      <div class="main-box">
        <div class="flex items-center justify-between border-b border-gray-200 pb-3 flex-wrap gap-2">
          <div class="flex items-center gap-3">
            <h2 class="font-bold text-lg text-zinc-800">لیست تراکنش ها </h2>
          </div>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-7 gap-4 py-4">
          <!-- Search -->
          <div class="relative">
            <input type="text" id="filterSearchInput" placeholder="جست و جو" class="w-full h-10 border border-main-color rounded-lg pr-4 pl-4 outline-none" />
            <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-6 h-6 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m20 20-3.5-3.5"></path>
            </svg>
          </div>

          <!-- نوع مالی -->
          <div id="filterTypeSelect" class="custom-select relative">
            <button class="select-btn w-full h-10 border border-main-color rounded-lg flex items-center justify-between px-4 bg-white">
              <span class="selected-value text-gray-700" data-placeholder="نوع مالی">نوع مالی</span>
              <svg class="w-5 h-5 transition" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </button>
            <div class="dropdown hidden absolute left-0 w-full border border-gray-400 bg-white rounded-lg shadow-lg z-50">
              <div class="p-2 border-b border-main-color-25">
                <input type="text" class="search-input w-full border border-main-color-25 rounded-md px-3 py-2 outline-none" placeholder="جستجو..." />
              </div>
              <div class="options max-h-52 overflow-y-auto">
                <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100" data-value="income">درآمد</div>
                <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100" data-value="expense">هزینه</div>
              </div>
            </div>
          </div>

          <!-- دسته -->
          <div id="filterCategorySelect" class="custom-select relative">
            <button class="select-btn w-full h-10 border border-main-color rounded-lg flex items-center justify-between px-4 bg-white">
              <span class="selected-value text-gray-700" data-placeholder="دسته">دسته</span>
              <svg class="w-5 h-5 transition" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </button>
            <div class="dropdown hidden absolute left-0 w-full border border-gray-400 bg-white rounded-lg shadow-lg z-50">
              <div class="p-2 border-b border-main-color-25">
                <input type="text" class="search-input w-full border border-main-color-25 rounded-md px-3 py-2 outline-none" placeholder="جستجو..." />
              </div>
              <div class="options max-h-52 overflow-y-auto">
                <% categories.forEach((cat) => { %>
                <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100"><%= cat %></div>
                <% }) %>
              </div>
            </div>
          </div>

          <!-- از تاریخ -->
          <div class="relative">
            <input type="text" id="filterDateFromPicker" class="date w-full h-10 date-none-txt wt-datepicker-input-element border border-main-color rounded-lg pr-4 pl-4 outline-none" placeholder="از تاریخ" autocomplete="off">
            <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-6 h-6 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <rect x="3" y="4" width="18" height="18" rx="2"></rect>
              <path d="M16 2v4M8 2v4M3 10h18"></path>
            </svg>
          </div>

          <!-- تا تاریخ -->
          <div class="relative">
            <input type="text" id="filterDateToPicker" class="date w-full h-10 date-none-txt wt-datepicker-input-element border border-main-color rounded-lg pr-4 pl-4 outline-none" placeholder="تا تاریخ" autocomplete="off">
            <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-6 h-6 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <rect x="3" y="4" width="18" height="18" rx="2"></rect>
              <path d="M16 2v4M8 2v4M3 10h18"></path>
            </svg>
          </div>

          <div class="col-span-1 md:col-span-3 lg:col-span-2">
            <div class="flex w-full justify-end">
              <button onclick="resetFilter()" class="px-4 py-2 rounded-lg border border-gray-300 text-gray-700">بازنشانی</button>
            </div>
          </div>
        </div>

        <div class="scrollable-table-container relative scrollbar border-gray-200 border rounded-md">
          <table class="w-full text-sm md:text-base">
            <thead class="bg-blue-50 shadow-sm">
              <tr>
                <th scope="col" class="sticky top-0 z-20 font-semibold text-gray-700 text-sm md:text-base bg-blue-50 backdrop-blur-sm">
                  <div class="flex items-center justify-between gap-2">
                    <span> تاریخ و ساعت</span>
                  </div>
                </th>
                <th scope="col" class="sticky top-0 z-20 font-semibold text-gray-700 text-sm md:text-base bg-blue-50 backdrop-blur-sm">
                  <div class="flex items-center gap-1.5">
                    <span> توضیحات</span>
                  </div>
                </th>
                <th scope="col" class="sticky top-0 z-20 font-semibold text-gray-700 text-sm md:text-base bg-blue-50 backdrop-blur-sm">
                  <div class="flex items-center gap-1.5">
                    <span> دسته</span>
                  </div>
                </th>
                <th scope="col" class="sticky top-0 z-20 font-semibold text-gray-700 text-sm md:text-base bg-blue-50 backdrop-blur-sm">
                  <div class="flex items-center gap-1.5">
                    <span> نوع مالی</span>
                  </div>
                </th>
                <th scope="col" class="sticky top-0 z-20 font-semibold text-gray-700 text-sm md:text-base bg-blue-50 backdrop-blur-sm">
                  <div class="flex items-center justify-between gap-2">
                    <span> مبلغ (تومان)</span>
                  </div>
                </th>
                <th scope="col" class="sticky top-0 z-20   font-semibold text-gray-700 text-sm md:text-base bg-blue-50 backdrop-blur-sm">
                  <div class="flex items-center justify-between gap-2">
                    <span> عملیات</span>
                  </div>
                </th>
              </tr>
            </thead>
            <tbody id="transactionsTableBody" class="divide-y divide-gray-100">
              <tr id="transactionsLoadingRow">
                <td colspan="6" class="px-5 py-6 text-center text-gray-400">در حال بارگذاری تراکنش‌ها...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>


  <!-- مودال ثبت / ویرایش تراکنش (هر دو از همین مودال استفاده می‌کنن) -->
  <div id="addTransactionModal" class="modal hidden fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-xl w-full max-w-2xl max-h-[90vh] flex flex-col relative">
      <!-- هدر ثابت -->
      <div class="flex items-center justify-between px-6 pt-6 pb-3 border-b border-gray-200">
        <h3 id="transactionModalTitle" class="font-bold text-lg text-zinc-800">ثبت تراکنش جدید</h3>
        <button type="button" onclick="closeModal()" class="text-gray-500 hover:text-gray-700">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 6L6 18M6 6l12 12" />
          </svg>
        </button>
      </div>

      <form id="transactionForm" class="flex flex-col flex-1">
        <!-- شناسه‌ی تراکنش موقع ویرایش پر می‌شه؛ موقع ثبت جدید خالیه -->
        <input type="hidden" id="transactionId" value="">

        <!-- بدنه اسکرول‌شونده -->
        <div class="modal-body overflow-y-auto scrollbar px-6 py-4">
          <div id="transactionFormError" class="hidden mb-3 rounded-lg px-4 py-2.5 text-sm bg-red-color-25 text-red-color"></div>

          <div class="grid grid-cols-2 gap-3.5">

            <div class="col-span-2">
              <label class="text-xs text-zinc-500 mb-1 block">عنوان <span class="text-red-color">*</span></label>
              <div class="relative">
                <input type="text" id="modalTitleInput" placeholder="عنوان (مثلاً بنزین ماشین)" class="w-full h-10 border border-main-color rounded-lg pr-4 pl-4 outline-none">
              </div>
            </div>

            <div class="col-span-1">
              <label class="text-xs text-zinc-500 mb-1 block">تاریخ <span class="text-red-color">*</span></label>
              <div class="relative">
                <input type="text" id="modalDatePicker" class="date w-full h-10 date-none-txt wt-datepicker-input-element border border-main-color rounded-lg pr-4 pl-4 outline-none" placeholder="تاریخ" autocomplete="off">

                <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-6 h-6 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                  <path d="M16 2v4M8 2v4M3 10h18"></path>
                </svg>
              </div>
            </div>

            <div class="col-span-1">
              <label class="text-xs text-zinc-500 mb-1 block">ساعت</label>
              <div class="relative">
                <input type="text" id="modalTimePicker" class="time-picker w-full h-10 date-none-txt border border-main-color rounded-lg pr-4 pl-4 outline-none" placeholder="ساعت" autocomplete="off">

                <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-6 h-6 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <circle cx="12" cy="12" r="9"></circle>
                  <path d="M12 7v5l3 3"></path>
                </svg>
              </div>
            </div>

            <div class="col-span-1">
              <label class="text-xs text-zinc-500 mb-1 block">نوع مالی <span class="text-red-color">*</span></label>
              <div id="modalFinancialTypeSelect" class="custom-select relative">
                <button type="button" class="select-btn w-full h-10 border border-main-color rounded-lg flex items-center justify-between px-4 bg-white">
                  <span class="selected-value text-gray-700" data-placeholder="نوع مالی">نوع مالی</span>
                  <svg class="w-5 h-5 transition" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="m6 9 6 6 6-6"></path>
                  </svg>
                </button>

                <div class="dropdown hidden absolute left-0 w-full border border-gray-400 bg-white rounded-lg shadow-lg z-50">
                  <div class="p-2 border-b border-main-color-25">
                    <input type="text" class="search-input w-full border border-main-color-25 rounded-md px-3 py-2 outline-none" placeholder="جستجو..." />
                  </div>
                  <div class="options max-h-52 overflow-y-auto">
                    <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100" data-value="income">واریز (درآمد)</div>
                    <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100" data-value="expense">برداشت (هزینه)</div>
                    <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100" data-value="transfer" id="modalTransferOption">انتقال بین حساب‌ها</div>
                  </div>
                </div>
              </div>
            </div>

            <div class="col-span-1" id="modalSubtypeWrapper">
              <label class="text-xs text-zinc-500 mb-1 block">نوع تراکنش</label>
              <div id="modalSubtypeSelect" class="custom-select relative">
                <button type="button" class="select-btn w-full h-10 border border-main-color rounded-lg flex items-center justify-between px-4 bg-white">
                  <span class="selected-value text-gray-700" data-placeholder="نوع تراکنش">نوع تراکنش</span>
                  <svg class="w-5 h-5 transition" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="m6 9 6 6 6-6"></path>
                  </svg>
                </button>

                <div class="dropdown hidden absolute left-0 w-full border border-gray-400 bg-white rounded-lg shadow-lg z-50">
                  <div class="p-2 border-b border-main-color-25">
                    <input type="text" class="search-input w-full border border-main-color-25 rounded-md px-3 py-2 outline-none" placeholder="جستجو..." />
                  </div>
                  <div class="options max-h-52 overflow-y-auto">
                    <!-- گزینه‌های برداشت (هزینه) -->
                    <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100" data-fintype="expense">خرید اینترنتی</div>
                    <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100" data-fintype="expense">خرید فروشگاه</div>
                    <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100" data-fintype="expense">انتقال به کارت</div>
                    <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100" data-fintype="expense">برداشت نقدی</div>
                    <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100" data-fintype="expense">پرداخت قبض</div>
                    <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100" data-fintype="expense">کارمزد</div>
                    <!-- گزینه‌های واریز (درآمد) -->
                    <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100" data-fintype="income">دریافت از کارت</div>
                    <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100" data-fintype="income">واریز نقدی</div>
                    <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100" data-fintype="income">حقوق و دستمزد</div>
                    <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100" data-fintype="income">پاداش و هدیه</div>
                    <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100" data-fintype="income">بازگشت وجه</div>
                    <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100" data-fintype="income">سود سپرده/سرمایه‌گذاری</div>
                    <!-- مشترک بین هر دو -->
                    <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100">سایر</div>
                  </div>
                </div>
              </div>
            </div>

            <div class="col-span-1">
              <label class="text-xs text-zinc-500 mb-1 block">مبلغ
                <span class="text-red-color">*</span>
              </label>
              <div class="relative">
                <input type="number" min="0" step="1" id="modalAmountInput" placeholder="قیمت " class="w-full h-10 border border-main-color rounded-lg pr-4 pl-4 outline-none">
              </div>
            </div>

            <div class="col-span-1" id="modalCategoryWrapper">
              <label class="text-xs text-zinc-500 mb-1 block">دسته بندی <span class="text-red-color">*</span></label>
              <div id="modalCategorySelect" class="custom-select relative">
                <button type="button" class="select-btn w-full h-10 border border-main-color rounded-lg flex items-center justify-between px-4 bg-white">
                  <span class="selected-value text-gray-700" data-placeholder="دسته">دسته</span>
                  <svg class="w-5 h-5 transition" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="m6 9 6 6 6-6"></path>
                  </svg>
                </button>

                <div class="dropdown hidden absolute left-0 w-full border border-gray-400 bg-white rounded-lg shadow-lg z-50">
                  <div class="p-2 border-b border-main-color-25">
                    <input type="text" class="search-input w-full border border-main-color-25 rounded-md px-3 py-2 outline-none" placeholder="جستجو..." />
                  </div>
                  <div class="options max-h-52 overflow-y-auto">
                    <% categories.forEach((cat) => { %>
                    <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100" data-fintype="expense"><%= cat %></div>
                    <% }) %>
                    <% incomeCategories.forEach((cat) => { %>
                    <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100" data-fintype="income"><%= cat %></div>
                    <% }) %>
                  </div>
                </div>
              </div>
            </div>

            <div class="col-span-2" id="modalAccountWrapper">
              <label class="text-xs text-zinc-500 mb-1 block">حساب <span class="text-red-color">*</span></label>
              <div class="custom-select relative" id="modalAccountCustomSelect">
                <!-- hidden input برای حفظ سازگاری با کدهای قدیمی -->
                <input type="hidden" id="modalAccountInput" value="" />

                <button type="button" class="select-btn w-full h-10 border border-main-color rounded-lg flex items-center justify-between px-4 bg-white">
                  <span class="selected-value text-gray-700" data-placeholder="بدون حساب">بدون حساب</span>
                  <svg class="w-5 h-5 transition" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="m6 9 6 6 6-6"></path>
                  </svg>
                </button>

                <div class="dropdown hidden absolute left-0 w-full border border-gray-400 bg-white rounded-lg shadow-lg z-50">
                  <div class="p-2 border-b border-main-color-25">
                    <input type="text" class="search-input w-full border border-main-color-25 rounded-md px-3 py-2 outline-none" placeholder="جستجوی حساب..." />
                  </div>
                  <div class="options max-h-52 overflow-y-auto">
                    <!-- گزینه‌ها توسط جاوااسکریپت پر می‌شوند -->
                  </div>
                </div>
              </div>
            </div>

            <!-- فقط برای «انتقال بین حساب‌ها» -->
            <div class="col-span-1 hidden" id="modalTransferFromWrapper">
              <label class="text-xs text-zinc-500 mb-1 block">از حساب <span class="text-red-color">*</span></label>
              <select id="modalTransferFromAccount" class="w-full h-10 border border-main-color rounded-lg pr-4 pl-4 outline-none bg-white"></select>
            </div>

            <div class="col-span-1 hidden" id="modalTransferToWrapper">
              <label class="text-xs text-zinc-500 mb-1 block">به حساب <span class="text-red-color">*</span></label>
              <select id="modalTransferToAccount" class="w-full h-10 border border-main-color rounded-lg pr-4 pl-4 outline-none bg-white"></select>
            </div>

            <div class="col-span-2">
              <div class="relative">
