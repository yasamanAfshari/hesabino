<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><% title = 'تراکنش ها' %></title>
</head>

<body class="bg-main-color overflow-hidden">

  <%- include('partials/header') %>

  <section class="scrollbar overflow-y-auto px-6 pb-1">
    <h3 class="font-bold text-zinc-950 text-center">مدیریت تراکنش ها</h3>
    <div class="main-box-small mt-3">
      <div class="flex justify-between items-center">
        <div class="">
          <button class="main-btn">دریافت خروجی</button>
          <button class="main-btn">افزودن csv بانکی</button>
        </div>
        <button class="main-btn" onclick="openModal('addTransactionModal')">ثبت تراکنش</button>
      </div>
    </div>

    <div class="grid grid-cols-1 mt-3">
      <div class="main-box">
        <div class="flex items-center justify-between border-b border-gray-200 pb-3 flex-wrap gap-2">
          <div class="flex items-center gap-3">
            <h2 class="font-bold text-lg text-zinc-800">لیست تراکنش ها </h2>
          </div>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-6 gap-4 py-4 bg-white">
          <!-- Search -->
          <div class="relative">
            <input type="text" placeholder="جست و جو" class="w-full h-10 border border-main-color rounded-lg pr-4 pl-4 outline-none" />
            <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-6 h-6 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m20 20-3.5-3.5"></path>
            </svg>
          </div>

          <!-- نوع مالی -->
          <div class="custom-select relative">
            <button class="select-btn w-full h-10 border border-main-color rounded-lg flex items-center justify-between px-4 bg-white">
              <span class="selected-value text-gray-700">نوع مالی</span>
              <svg class="w-5 h-5 transition" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </button>
            <div class="dropdown hidden absolute left-0 w-full bg-white rounded-lg shadow-lg z-50">
              <div class="p-2 border-b border-main-color-25">
                <input type="text" class="search-input w-full border border-main-color-25 rounded-md px-3 py-2 outline-none" placeholder="جستجو..." />
              </div>
              <div class="options max-h-52 overflow-y-auto">
                <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100">درآمد</div>
                <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100">هزینه</div>
                <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100">سرمایه گذاری</div>
                <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100">وام</div>
                <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100">پس انداز</div>
                <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100">سایر</div>
              </div>
            </div>
          </div>

          <!-- دسته -->
          <div class="custom-select relative">
            <button class="select-btn w-full h-10 border border-main-color rounded-lg flex items-center justify-between px-4 bg-white">
              <span class="selected-value text-gray-700">دسته</span>
              <svg class="w-5 h-5 transition" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </button>
            <div class="dropdown hidden absolute left-0 w-full bg-white rounded-lg shadow-lg z-50">
              <div class="p-2 border-b border-main-color-25">
                <input type="text" class="search-input w-full border border-main-color-25 rounded-md px-3 py-2 outline-none" placeholder="جستجو..." />
              </div>
              <div class="options max-h-52 overflow-y-auto">
                <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100">خوراک</div>
                <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100">حمل و نقل</div>
                <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100">تفریح</div>
                <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100">درمان</div>
              </div>
            </div>
          </div>

          <!-- تاریخ -->
          <div class="relative">
            <input type="text" id="filterDatePicker" class="date w-full h-10 date-none-txt wt-datepicker-input-element border border-main-color rounded-lg pr-4 pl-4 outline-none" placeholder="تاریخ" autocomplete="off">
            <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-6 h-6 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <rect x="3" y="4" width="18" height="18" rx="2"></rect>
              <path d="M16 2v4M8 2v4M3 10h18"></path>
            </svg>
          </div>

          <div class="col-span-2">
            <div class="flex w-full justify-end">
              <button onclick="resetFilter()" class="px-4 py-2 rounded-lg border border-gray-300 text-gray-700">بازنشانی</button>
            </div>
          </div>
        </div>

        <div class="scrollable-table-container relative scrollbar border-gray-200 border rounded-md">
          <table class="w-full text-sm md:text-base">
            <thead class="bg-blue-50 shadow-sm">
              <tr>
                <th scope="col" class="sticky top-0 z-20 font-semibold text-gray-700 text-sm md:text-base bg-blue-50 backdrop-blur-sm">
                  <div class="flex items-center justify-between gap-2">
