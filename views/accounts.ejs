<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    <% title = 'حساب‌ها' %>
  </title>
  <style>
    .main-box {
      height: 60vh !important;
    }

    /* ========== استایل تب‌ها ========== */
    .tab-btn {
      position: relative;
      transition: all 0.2s ease;
      white-space: nowrap;
    }

    .tab-btn::after {
      content: '';
      position: absolute;
      bottom: -8px;
      left: 0;
      right: 0;
      height: 2.5px;
      background-color: var(--color-main-color, #3b82f6);
      border-radius: 2px 2px 0 0;
      transform: scaleX(0);
      transition: transform 0.2s ease;
    }

    .tab-btn.active {
      color: var(--color-main-color, #3b82f6);
      font-weight: 700;
    }

    .tab-btn.active::after {
      transform: scaleX(1);
    }

    .tab-btn:not(.active):hover {
      color: #52525b;
    }

    .tab-panel {
      display: none;
      flex-direction: column;
      height: 100%;
    }

    .tab-panel.active {
      display: flex;
    }

    /* برای اسکرول داخلی تب‌ها */
    .tab-scroll-area {
      flex: 1;
      overflow-y: auto;
      min-height: 0;
    }
  </style>
</head>

<body class="bg-main-color overflow-hidden">

  <%- include('partials/header', { pageTitle: 'مدیریت حساب‌ها' }) %>

  <section class="scrollbar overflow-y-auto px-6 pb-1">

    <!-- کارت‌های آمار -->
    <div class="overflow-x-auto scrollbar">
      <div class="grid grid-cols-3 gap-4 min-w-max">
        <div class="main-box-small dashboard-status">
          <div class="flex justify-start gap-4">
            <div class="w-16 h-16 bg-main-color-25 p-2 flex justify-center items-center rounded-lg border border-main-color">
              <svg width="30" height="30" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M2 8.5H22" stroke="var(--color-main-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M6.44 3.5H17.55C20.56 3.5 22 4.89 22 7.97V16.02C22 19.1 20.56 20.49 17.56 20.49H6.44C3.44 20.49 2 19.1 2 16.02V7.97C2 4.89 3.44 3.5 6.44 3.5Z" stroke="var(--color-main-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
            <div>
              <div class="text-zinc-700 font-bold !text-lg">تعداد حساب‌ها</div>
              <div class="text-zinc-500 !text-md my-2.5" id="accountsCount">۰ عدد</div>
            </div>
          </div>
        </div>

        <div class="main-box-small dashboard-status">
          <div class="flex justify-start gap-4">
            <div class="w-16 h-16 bg-green-color-25 p-2 flex justify-center items-center rounded-lg border border-green-color">
              <svg width="28" height="28" viewBox="0 0 24 23" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M8.4165 13.7328C8.4165 14.969 9.37736 15.9657 10.5712 15.9657H13.0073C14.0458 15.9657 14.8902 15.0936 14.8902 14.0203C14.8902 12.8511 14.3758 12.439 13.609 12.1707L9.69765 10.829C8.9309 10.5607 8.4165 10.1486 8.4165 8.97943C8.4165 7.90609 9.26089 7.03401 10.2994 7.03401H12.7355C13.9293 7.03401 14.8902 8.03068 14.8902 9.26693" stroke="var(--color-green-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                <path d="M11.6467 5.75V17.25" stroke="var(--color-green-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                <path d="M14.5585 21.0833H8.73511C3.88229 21.0833 1.94116 19.1667 1.94116 14.375V8.625C1.94116 3.83334 3.88229 1.91667 8.73511 1.91667H14.5585C19.4113 1.91667 21.3524 3.83334 21.3524 8.625V14.375C21.3524 19.1667 19.4113 21.0833 14.5585 21.0833Z" stroke="var(--color-green-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </div>
            <div>
              <div class="text-zinc-700 font-bold !text-lg">مجموع موجودی (تومان)</div>
              <div class="text-zinc-500 !text-md my-2.5" id="accountsTotalBalance">۰ تومان
              </div>
            </div>
          </div>
        </div>

        <div class="main-box-small dashboard-status">
          <div class="flex justify-start gap-4">
            <div class="w-16 h-16 bg-orange-color-25 p-2 flex justify-center items-center rounded-lg border border-orange-color">
              <svg width="30" height="30" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="var(--color-orange-color)" class="size-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="m20.25 7.5-.625 10.632a2.25 2.25 0 0 1-2.247 2.118H6.622a2.25 2.25 0 0 1-2.247-2.118L3.75 7.5m8.25 3v6.75m0 0-3-3m3 3 3-3M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125Z" />
              </svg>

            </div>
            <div>
              <div class="text-zinc-700 font-bold !text-lg">حساب‌های آرشیوشده</div>
              <div class="text-zinc-500 !text-md my-2.5" id="accountsArchivedCount">۰ عدد
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ========== باکس تب‌بندی شده (حساب‌ها + آخرین انتقال‌ها) ========== -->
    <div class="grid grid-cols-1 my-2">
      <div class="main-box flex flex-col">

        <!-- هدر باکس + تب‌ها -->
        <div class="flex items-center justify-between mb-1 border-b border-gray-200 pb-0 flex-wrap gap-2 flex-shrink-0">
          <div class="flex items-center gap-1 w-full justify-between mb-2">
            <!-- دکمه‌های تب -->
            <div class="flex items-center gap-0">
              <button class="tab-btn active px-4 py-2.5 text-sm text-zinc-400 transition-colors" data-tab="accounts" onclick="switchTab('accounts')">
                حساب‌ها
              </button>
              <button class="tab-btn px-4 py-2.5 text-sm text-zinc-400 transition-colors" data-tab="transfers" onclick="switchTab('transfers')">
                آخرین انتقال‌ها
              </button>
            </div>


          </div>
        </div>

        <!-- محتوای تب‌ها -->
        <div class="flex-1 min-h-0">

          <!-- تب حساب‌ها -->
          <div class="tab-panel active" id="tabPanelAccounts">
            <div class="tab-scroll-area px-2 scrollbar">
              <!-- دکمه‌های عملیات (چیدمان گرید، سمت چپ) -->
              <div class="grid grid-cols-1 sm:grid-cols-[1fr_auto] gap-3" id="tabActionsAccounts">
                <div class="flex flex-wrap items-center justify-end gap-3">
                  <div class="flex flex-wrap items-center justify-end gap-3 w-full sm:w-auto">
                    <label class="flex items-center gap-2 text-sm text-zinc-600 cursor-pointer select-none whitespace-nowrap order-last sm:order-none w-full sm:w-auto">
                      <input type="checkbox" id="showArchivedToggle" onchange="AccountsApp.toggleShowArchived()">
                      نمایش آرشیوشده‌ها
                    </label>
                    <button class="px-4 py-2 rounded-lg border border-main-color text-main-color text-sm whitespace-nowrap justify-end order-first sm:order-none" onclick="AccountsApp.openTransferModal()">انتقال بین حساب‌ها</button>
                    <button class="main-btn text-sm whitespace-nowrap order-first sm:order-none" onclick="AccountsApp.openAddModal()">حساب جدید</button>
                  </div>
                </div>
              </div>

              <div class="space-y-4 grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-4 grc gap-4 mt-2" id="accountsList">
                <p class="text-center text-gray-400 mt-6 col-span-full">در حال بارگذاری حساب‌ها...</p>
              </div>
            </div>
          </div>

          <!-- تب آخرین انتقال‌ها -->
          <div class="tab-panel" id="tabPanelTransfers">
            <div class="tab-scroll-area px-2">
              <div class="space-y-2 mt-2" id="transfersList">
                <p class="text-center text-gray-400 mt-6">در حال بارگذاری انتقال‌ها...</p>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- مودال‌ها (بدون تغییر) -->

  <!-- مودال افزودن حساب -->
  <div id="addAccount" class="modal hidden fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-xl max-w-2xl max-h-[90vh] lg:w-[25vw] w-full flex flex-col relative">
      <div class="flex items-center justify-between px-6 pt-6 pb-3 border-b border-gray-200">
        <h3 class="font-bold text-lg text-zinc-800">افزودن حساب جدید</h3>
        <button onclick="closeModal()" class="text-gray-500 hover:text-gray-700">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 6L6 18M6 6l12 12" />
          </svg>
        </button>
      </div>

      <div class="modal-body overflow-y-auto flex flex-col gap-3 scrollbar px-6 py-4">
        <div id="addAccountError" class="hidden text-sm text-red-color bg-red-color-25 border border-red-color rounded-lg px-3 py-2">
        </div>

        <div class="relative">
          <input type="text" id="addAccountName" placeholder="نام حساب (مثلاً بانک ملت)" class="w-full h-10 border border-main-color rounded-lg pr-4 pl-4 outline-none">
        </div>

        <div class="relative">
          <select id="addAccountType" class="w-full h-10 border border-main-color rounded-lg pr-4 pl-4 outline-none">
            <option value="bank">بانک</option>
            <option value="cash">نقدی</option>
            <option value="digital_wallet">کیف پول دیجیتال</option>
            <option value="crypto">ارز دیجیتال</option>
            <option value="other">سایر</option>
          </select>
        </div>

        <div class="relative">
          <select id="addAccountCurrency" class="w-full h-10 border border-main-color rounded-lg pr-4 pl-4 outline-none">
            <option value="IRR">تومان (IRR)</option>
            <option value="USD">دلار (USD)</option>
            <option value="EUR">یورو (EUR)</option>
            <option value="TRY">لیر ترکیه (TRY)</option>
            <option value="AED">درهم امارات (AED)</option>
          </select>
        </div>

        <div class="relative">
          <input type="number" id="addAccountOpeningBalance" placeholder="سرمایه اولیه (اختیاری)" class="w-full h-10 border border-main-color rounded-lg pr-4 pl-4 outline-none">
        </div>

        <div class="relative">
          <textarea id="addAccountNote" maxlength="200" placeholder="یادداشت (اختیاری)" class="w-full border border-main-color rounded-lg pr-4 pl-4 py-2 outline-none" rows="2"></textarea>
        </div>
      </div>

      <div class="flex justify-end gap-2 px-6 pb-6 pt-4 border-t border-gray-200">
        <button onclick="closeModal()" class="px-4 py-2 rounded-lg border border-gray-300 text-gray-700">انصراف</button>
        <button class="main-btn px-4 py-2 rounded-lg" id="addAccountSubmitBtn" onclick="AccountsApp.submitCreate()">ثبت</button>
      </div>
    </div>
  </div>

  <!-- مودال ویرایش حساب -->
  <div id="editAccount" class="modal hidden fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-xl lg:w-[25vw] w-full max-w-2xl max-h-[90vh] flex flex-col relative">
      <div class="flex items-center justify-between px-6 pt-6 pb-3 border-b border-gray-200">
        <h3 class="font-bold text-lg text-zinc-800">ویرایش حساب</h3>
        <button onclick="closeModal()" class="text-gray-500 hover:text-gray-700">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 6L6 18M6 6l12 12" />
          </svg>
        </button>
      </div>

      <div class="modal-body overflow-y-auto flex flex-col gap-3 scrollbar px-6 py-4">
        <input type="hidden" id="editAccountId">
        <div id="editAccountError" class="hidden text-sm text-red-color bg-red-color-25 border border-red-color rounded-lg px-3 py-2">
        </div>

        <div class="relative">
          <input type="text" id="editAccountName" placeholder="نام حساب" class="w-full h-10 border border-main-color rounded-lg pr-4 pl-4 outline-none">
        </div>

        <div class="relative">
          <select id="editAccountType" class="w-full h-10 border border-main-color rounded-lg pr-4 pl-4 outline-none">
            <option value="bank">بانک</option>
            <option value="cash">نقدی</option>
            <option value="digital_wallet">کیف پول دیجیتال</option>
            <option value="crypto">ارز دیجیتال</option>
            <option value="other">سایر</option>
          </select>
        </div>

        <div class="relative">
          <select id="editAccountCurrency" class="w-full h-10 border border-main-color rounded-lg pr-4 pl-4 outline-none">
            <option value="IRR">تومان (IRR)</option>
            <option value="USD">دلار (USD)</option>
            <option value="EUR">یورو (EUR)</option>
            <option value="TRY">لیر ترکیه (TRY)</option>
            <option value="AED">درهم امارات (AED)</option>
          </select>
        </div>

        <div class="relative">
          <input type="number" id="editAccountOpeningBalance" placeholder="سرمایه اولیه" class="w-full h-10 border border-main-color rounded-lg pr-4 pl-4 outline-none">
        </div>

        <div class="relative">
          <textarea id="editAccountNote" maxlength="200" placeholder="یادداشت (اختیاری)" class="w-full border border-main-color rounded-lg pr-4 pl-4 py-2 outline-none" rows="2"></textarea>
        </div>
      </div>

      <div class="flex justify-end gap-2 px-6 pb-6 pt-4 border-t border-gray-200">
        <button onclick="AccountsApp.submitArchiveToggle()" id="editAccountArchiveBtn" class="px-4 py-2 rounded-lg border border-red-color text-red-color">آرشیو حساب</button>
        <button onclick="closeModal()" class="px-4 py-2 rounded-lg border border-gray-300 text-gray-700">انصراف</button>
        <button class="main-btn px-4 py-2 rounded-lg" id="editAccountSubmitBtn" onclick="AccountsApp.submitUpdate()">ثبت</button>
      </div>
    </div>
  </div>

  <!-- مودال انتقال بین حساب‌ها -->
  <div id="transferAccount" class="modal hidden fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-xl max-w-2xl max-h-[90vh] lg:w-[28vw] w-full flex flex-col relative">
      <div class="flex items-center justify-between px-6 pt-6 pb-3 border-b border-gray-200">
        <h3 class="font-bold text-lg text-zinc-800">انتقال بین حساب‌ها</h3>
        <button onclick="closeModal()" class="text-gray-500 hover:text-gray-700">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 6L6 18M6 6l12 12" />
          </svg>
        </button>
      </div>

      <div class="modal-body overflow-y-auto flex flex-col gap-3 scrollbar px-6 py-4">
        <div id="transferError" class="hidden text-sm text-red-color bg-red-color-25 border border-red-color rounded-lg px-3 py-2">
        </div>

        <div class="relative">
          <input type="text" id="transferTitle" placeholder=" عنوان" class="w-full h-10 border border-main-color rounded-lg pr-4 pl-4 outline-none">
        </div>

        <div class="relative">
          <label class="text-xs text-zinc-500 mb-1 block">از حساب</label>
          <select id="transferFromAccount" class="w-full h-10 border border-main-color rounded-lg pr-4 pl-4 outline-none bg-white"></select>
        </div>

        <div class="relative">
          <label class="text-xs text-zinc-500 mb-1 block">به حساب</label>
          <select id="transferToAccount" class="w-full h-10 border border-main-color rounded-lg pr-4 pl-4 outline-none bg-white"></select>
        </div>

        <div class="relative">
          <label class="text-xs text-zinc-500 mb-1 block">مبلغ (تومان)</label>
          <input type="number" min="0" step="1" id="transferAmount" placeholder="مثلاً ۵۰۰۰۰۰۰" class="w-full h-10 border border-main-color rounded-lg pr-4 pl-4 outline-none">
        </div>

        <div class="relative">
          <label class="text-xs text-zinc-500 mb-1 block">تاریخ</label>
          <input type="text" id="transferDate" class="date w-full h-10 date-none-txt wt-datepicker-input-element border border-main-color rounded-lg pr-4 pl-4 outline-none" placeholder="تاریخ" autocomplete="off">
        </div>

        <div class="relative">
          <label class="text-xs text-zinc-500 mb-1 block">توضیحات (اختیاری)</label>
          <textarea rows="3" id="transferDescription" class="w-full border border-main-color rounded-lg pr-4 pl-4 outline-none" placeholder="مثلاً جابه‌جایی برای پرداخت قسط"></textarea>
        </div>
      </div>

      <div class="flex justify-end gap-2 px-6 pb-6 pt-4 border-t border-gray-200">
        <button onclick="closeModal()" class="px-4 py-2 rounded-lg border border-gray-300 text-gray-700">انصراف</button>
        <button class="main-btn px-4 py-2 rounded-lg" id="transferSubmitBtn" onclick="AccountsApp.submitTransfer()">ثبت انتقال</button>
      </div>
    </div>
  </div>

  <script>
    function openModal(id) {
      const modal = document.getElementById(id);
      if (!modal) return;
      modal.classList.remove('hidden');
      requestAnimationFrame(() => {
        requestAnimationFrame(() => modal.classList.add('is-open'));
      });
      document.body.classList.add('overflow-hidden');
    }

    function closeModal() {
      document.querySelectorAll('.modal.is-open').forEach((modal) => {
        modal.classList.remove('is-open');
        setTimeout(() => modal.classList.add('hidden'), 250);
      });
      document.body.classList.remove('overflow-hidden');
    }

    // ========== تابع سویچ تب ==========
    function switchTab(tabName) {
      // حذف کلاس active از همه تب‌ها
      document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
      document.querySelectorAll('.tab-panel').forEach(panel => panel.classList.remove('active'));

      // افزودن کلاس active به تب انتخاب شده
      const activeBtn = document.querySelector(`.tab-btn[data-tab="${tabName}"]`);
      const activePanel = document.getElementById(
        tabName === 'accounts' ? 'tabPanelAccounts' : 'tabPanelTransfers'
      );

      if (activeBtn) activeBtn.classList.add('active');
      if (activePanel) activePanel.classList.add('active');

      // نمایش/مخفی کردن دکمه‌های عملیات مربوط به هر تب
      const actionsAccounts = document.getElementById('tabActionsAccounts');
      const actionsTransfers = document.getElementById('tabActionsTransfers');

      if (tabName === 'accounts') {
        if (actionsAccounts) actionsAccounts.classList.remove('hidden');
        if (actionsTransfers) actionsTransfers.classList.add('hidden');
      } else {
        if (actionsAccounts) actionsAccounts.classList.add('hidden');
        if (actionsTransfers) actionsTransfers.classList.remove('hidden');
      }
    }
  </script>

  <script src="/JS/accounts.js" defer></script>
</body>

</html>