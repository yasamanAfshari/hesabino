<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>
  <meta charset="UTF-8">
  <script>
    // اگه کاربر از قبل توکن معتبر داره، مستقیم بفرستش داشبورد
    (function () {
      var token = localStorage.getItem('access_token');
      if (!token) return;
      try {
        var payload = JSON.parse(atob(token.split('.')[1]));
        if (!payload.exp || Date.now() < payload.exp * 1000) {
          window.location.replace('/');
        } else {
          localStorage.removeItem('access_token');
        }
      } catch (e) {
        localStorage.removeItem('access_token');
      }
    })();
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>حسابینو - ورود و ثبت‌نام</title>
  <link rel="stylesheet" href="/css/output.css">
  <link rel="stylesheet" href="/css/global.css">
</head>

<body class="bg-back-color min-h-screen flex items-center justify-center p-5 relative overflow-hidden">

  <!-- یه هاله‌ی نرم از رنگ برند پشت کارت، به‌جای پس‌زمینه‌ی تخت -->
  <div class="pointer-events-none absolute -top-32 -left-32 w-96 h-96 rounded-full bg-main-color-25 blur-3xl opacity-60"></div>
  <div class="pointer-events-none absolute -bottom-32 -right-24 w-96 h-96 rounded-full bg-green2-color-25 blur-3xl opacity-50"></div>

  <div class="main-box w-full max-w-md !h-auto !p-8 flex flex-col relative">

    <!-- لوگو -->
    <div class="flex flex-col items-center mb-7">
      <img src="/Images/logo-typo.png" alt="حسابینو" class="h-9 mb-2">
      <p class="text-xs text-gray-400">مدیریت هوشمند درآمد، هزینه و پس‌انداز شما</p>
    </div>

    <!-- تب‌ها -->
    <div class="flex mb-7">
      <button type="button" onclick="switchTab('login')" id="loginTab"
        class="tab-btn flex-1 pb-3 text-sm font-medium transition-colors border-b-2 border-main-color text-main-color">
        ورود
      </button>
      <button type="button" onclick="switchTab('register')" id="registerTab"
        class="tab-btn flex-1 pb-3 text-sm font-medium transition-colors border-b-2 border-transparent text-gray-400 hover:text-gray-600">
        ثبت‌نام
      </button>
    </div>

    <!-- فرم ورود -->
    <div class="form-container" id="loginForm">
      <form onsubmit="login(event)" class="flex flex-col gap-4">
        <div>
          <label class="block text-sm text-gray-600 mb-1">ایمیل</label>
          <div class="relative">
            <svg class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 8L10.89 13.26C11.5 13.67 12.5 13.67 13.11 13.26L21 8" />
              <rect x="3" y="5" width="18" height="14" rx="2" />
            </svg>
            <input type="email" id="loginEmail" placeholder="example@email.com" required
              class="w-full h-11 border border-gray-200 focus:border-main-color rounded-lg pr-10 pl-4 outline-none transition-colors">
          </div>
          <div class="error-message hidden text-red-color text-xs mt-1" id="loginEmailError">لطفاً یک ایمیل معتبر
            وارد کنید</div>
        </div>
        <div>
          <label class="block text-sm text-gray-600 mb-1">رمز عبور</label>
          <div class="relative">
            <svg class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="4" y="10" width="16" height="10" rx="2" />
              <path d="M7 10V7a5 5 0 0 1 10 0v3" />
            </svg>
            <input type="password" id="loginPassword" placeholder="حداقل ۶ کاراکتر" required minlength="6"
              class="w-full h-11 border border-gray-200 focus:border-main-color rounded-lg pr-10 pl-4 outline-none transition-colors">
          </div>
          <div class="error-message hidden text-red-color text-xs mt-1" id="loginPasswordError">رمز عبور حداقل ۶
            کاراکتر باید باشد</div>
        </div>
        <button type="submit" id="loginBtn"
          class="w-full h-11 bg-main-color hover:bg-main-color-hover text-white rounded-lg text-sm font-medium transition-colors flex items-center justify-center gap-2 mt-1">
          <span class="spinner hidden w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
          <span class="btn-text">ورود</span>
        </button>
        <div class="message hidden text-sm rounded-lg p-3 text-center" id="loginMessage"></div>
      </form>
    </div>

    <!-- فرم ثبت‌نام -->
    <div class="form-container hidden" id="registerForm">
      <form onsubmit="register(event)" class="flex flex-col gap-4">
        <div>
          <label class="block text-sm text-gray-600 mb-1">نام کامل</label>
          <div class="relative">
            <svg class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="8" r="4" />
              <path d="M4 20c0-3.5 3.5-6 8-6s8 2.5 8 6" />
            </svg>
            <input type="text" id="registerFullname" placeholder="یاسمن افشاری" required
              class="w-full h-11 border border-gray-200 focus:border-main-color rounded-lg pr-10 pl-4 outline-none transition-colors">
          </div>
          <div class="error-message hidden text-red-color text-xs mt-1" id="registerFullnameError">نام کامل الزامی
            است</div>
        </div>
        <div>
          <label class="block text-sm text-gray-600 mb-1">ایمیل</label>
          <div class="relative">
            <svg class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 8L10.89 13.26C11.5 13.67 12.5 13.67 13.11 13.26L21 8" />
              <rect x="3" y="5" width="18" height="14" rx="2" />
            </svg>
            <input type="email" id="registerEmail" placeholder="example@email.com" required
              class="w-full h-11 border border-gray-200 focus:border-main-color rounded-lg pr-10 pl-4 outline-none transition-colors">
          </div>
          <div class="error-message hidden text-red-color text-xs mt-1" id="registerEmailError">لطفاً یک ایمیل معتبر
            وارد کنید</div>
        </div>
        <div>
          <label class="block text-sm text-gray-600 mb-1">رمز عبور</label>
          <div class="relative">
            <svg class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="4" y="10" width="16" height="10" rx="2" />
              <path d="M7 10V7a5 5 0 0 1 10 0v3" />
            </svg>
            <input type="password" id="registerPassword" placeholder="حداقل ۶ کاراکتر" required minlength="6"
              class="w-full h-11 border border-gray-200 focus:border-main-color rounded-lg pr-10 pl-4 outline-none transition-colors">
          </div>
          <div class="error-message hidden text-red-color text-xs mt-1" id="registerPasswordError">رمز عبور حداقل ۶
            کاراکتر باید باشد</div>
        </div>
        <button type="submit" id="registerBtn"
          class="w-full h-11 bg-main-color hover:bg-main-color-hover text-white rounded-lg text-sm font-medium transition-colors flex items-center justify-center gap-2 mt-1">
          <span class="spinner hidden w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
          <span class="btn-text">ثبت‌نام</span>
        </button>
        <div class="message hidden text-sm rounded-lg p-3 text-center" id="registerMessage"></div>
      </form>
    </div>

  </div>

  <script>
    // ===== متغیرها =====
    const API_BASE = '';

    // ===== تابع تغییر تب =====
    function switchTab(tab) {
      const isLogin = tab === 'login';

      document.getElementById('loginForm').classList.toggle('hidden', !isLogin);
      document.getElementById('registerForm').classList.toggle('hidden', isLogin);

      const loginTab = document.getElementById('loginTab');
      const registerTab = document.getElementById('registerTab');

      loginTab.classList.toggle('border-main-color', isLogin);
      loginTab.classList.toggle('text-main-color', isLogin);
      loginTab.classList.toggle('border-transparent', !isLogin);
      loginTab.classList.toggle('text-gray-400', !isLogin);

      registerTab.classList.toggle('border-main-color', !isLogin);
      registerTab.classList.toggle('text-main-color', !isLogin);
      registerTab.classList.toggle('border-transparent', isLogin);
      registerTab.classList.toggle('text-gray-400', isLogin);

      clearMessages();
    }

    // ===== پاک کردن پیام‌ها =====
    function clearMessages() {
      document.querySelectorAll('.message').forEach(el => {
        el.className = 'message hidden text-sm rounded-lg p-3 text-center';
        el.textContent = '';
      });
      document.querySelectorAll('.error-message').forEach(el => el.classList.add('hidden'));
      document.querySelectorAll('input').forEach(el => el.classList.remove('!border-red-color'));
    }

    // ===== نمایش پیام =====
    function showMessage(elementId, text, type) {
      const el = document.getElementById(elementId);
      const isSuccess = type === 'success';
      el.className = `message text-sm rounded-lg p-3 text-center ${isSuccess ? 'bg-green-color-25 text-green-color' : 'bg-red-color-25 text-red-color'}`;
      el.textContent = text;
    }

    // ===== نمایش/مخفی کردن حالت لودینگ دکمه =====
    function setLoading(btn, loading, loadingText) {
      const spinner = btn.querySelector('.spinner');
      const btnText = btn.querySelector('.btn-text');
      btn.disabled = loading;
      spinner.classList.toggle('hidden', !loading);
      if (loading) {
        btn.dataset.originalText = btnText.textContent;
        btnText.textContent = loadingText;
      } else {
        btnText.textContent = btn.dataset.originalText || btnText.textContent;
      }
    }

    // ===== اعتبارسنجی ورودی‌ها =====
    function validateLogin() {
      let valid = true;
      const email = document.getElementById('loginEmail');
      const password = document.getElementById('loginPassword');

      if (!email.value || !email.value.includes('@')) {
        document.getElementById('loginEmailError').classList.remove('hidden');
        email.classList.add('!border-red-color');
        valid = false;
      } else {
        document.getElementById('loginEmailError').classList.add('hidden');
        email.classList.remove('!border-red-color');
      }

      if (!password.value || password.value.length < 6) {
        document.getElementById('loginPasswordError').classList.remove('hidden');
        password.classList.add('!border-red-color');
        valid = false;
      } else {
        document.getElementById('loginPasswordError').classList.add('hidden');
        password.classList.remove('!border-red-color');
      }

      return valid;
    }

    function validateRegister() {
      let valid = true;
      const fullname = document.getElementById('registerFullname');
      const email = document.getElementById('registerEmail');
      const password = document.getElementById('registerPassword');

      if (!fullname.value.trim()) {
        document.getElementById('registerFullnameError').classList.remove('hidden');
        fullname.classList.add('!border-red-color');
        valid = false;
      } else {
        document.getElementById('registerFullnameError').classList.add('hidden');
        fullname.classList.remove('!border-red-color');
      }

      if (!email.value || !email.value.includes('@')) {
        document.getElementById('registerEmailError').classList.remove('hidden');
        email.classList.add('!border-red-color');
        valid = false;
      } else {
        document.getElementById('registerEmailError').classList.add('hidden');
        email.classList.remove('!border-red-color');
      }

      if (!password.value || password.value.length < 6) {
        document.getElementById('registerPasswordError').classList.remove('hidden');
        password.classList.add('!border-red-color');
        valid = false;
      } else {
        document.getElementById('registerPasswordError').classList.add('hidden');
        password.classList.remove('!border-red-color');
      }

      return valid;
    }

    // ===== ثبت‌نام =====
    async function register(event) {
      event.preventDefault();
      clearMessages();

      if (!validateRegister()) return;

      const btn = document.getElementById('registerBtn');
      setLoading(btn, true, 'در حال ثبت‌نام...');

      const data = {
        fullname: document.getElementById('registerFullname').value.trim(),
        email: document.getElementById('registerEmail').value.trim(),
        password: document.getElementById('registerPassword').value
      };

      try {
        const response = await fetch(`${API_BASE}/users/register`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        const result = await response.json();

        if (response.ok && result.access_token) {
          // ثبت‌نام موفق بود و سرور خودش توکن ورود رو هم برگردوند؛
          // نیازی نیست کاربر دوباره فرم لاگین رو پر کنه
          localStorage.setItem('access_token', result.access_token);
          window.location.href = '/';
        } else {
          showMessage('registerMessage', result.message || 'خطا در ثبت‌نام. لطفاً دوباره تلاش کن.', 'error');
          setLoading(btn, false);
        }
      } catch (error) {
        showMessage('registerMessage', '❌ خطا در ارتباط با سرور. مطمئن شو سرور روشن است.', 'error');
        setLoading(btn, false);
      }
    }

    // ===== ورود =====
    async function login(event) {
      event.preventDefault();
      clearMessages();

      if (!validateLogin()) return;

      const btn = document.getElementById('loginBtn');
      setLoading(btn, true, 'در حال ورود...');

      const data = {
        email: document.getElementById('loginEmail').value.trim(),
        password: document.getElementById('loginPassword').value
      };

      try {
        const response = await fetch(`${API_BASE}/users/login`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        const result = await response.json();

        if (response.ok && result.access_token) {
          // ذخیره توکن در localStorage تا وقتی خودش خروج بزنه معتبر بمونه
          localStorage.setItem('access_token', result.access_token);

          // انتقال به داشبورد (روت اصلی)
          window.location.href = '/';
        } else {
          showMessage('loginMessage', result.message || '❌ ایمیل یا رمز عبور اشتباه است.', 'error');
          setLoading(btn, false);
        }
      } catch (error) {
        showMessage('loginMessage', '❌ خطا در ارتباط با سرور. مطمئن شو سرور روشن است.', 'error');
        setLoading(btn, false);
      }
    }

    // ===== بررسی توکن هنگام لود صفحه =====
    // (چک اصلی و ریدایرکت همون بالای head انجام میشه؛ این فقط یه پشتیبان برای مرورگرهای قدیمیه)
    document.addEventListener('DOMContentLoaded', () => {
      const token = localStorage.getItem('access_token');
      if (token) {
        window.location.replace('/');
      }
    });
  </script>
</body>

</html>
