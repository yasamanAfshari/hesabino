<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    <% title = 'مدیریت بدهی و طلب' %>
  </title>
  <style>
    .main-box {
      height: 60vh !important;
    }

    /* ========== استایل تب‌ها (هم‌شکل با صفحه‌ی حساب‌ها) ========== */
    .tab-btn {
      position: relative;
      transition: all 0.2s ease;
      white-space: nowrap;
    }

    .tab-btn::after {
      content: '';
      position: absolute;
      bottom: -8px;
      left: 0;
      right: 0;
      height: 2.5px;
      background-color: var(--color-main-color, #3b82f6);
      border-radius: 2px 2px 0 0;
      transform: scaleX(0);
      transition: transform 0.2s ease;
    }

    .tab-btn.active {
      color: var(--color-main-color, #3b82f6);
      font-weight: 700;
    }

    .tab-btn.active::after {
      transform: scaleX(1);
    }

    .tab-btn:not(.active):hover {
      color: #52525b;
    }

    .tab-panel {
      display: none;
      flex-direction: column;
      height: 100%;
    }

    .tab-panel.active {
      display: flex;
    }

    /* برای اسکرول داخلی تب‌ها */
    .tab-scroll-area {
      flex: 1;
      overflow-y: auto;
      min-height: 0;
    }

    .scrollable-table-container {
      overflow: auto;
      flex: 1;
      min-height: 0;
    }

    @media (max-width: 768px) {
      .scrollable-table-container {
        height: 45%;
      }
    }
  </style>
</head>

<body class="bg-main-color overflow-hidden">

    <%- include('partials/header' , { pageTitle: 'مدیریت بدهی و طلب' } ) %>

  <section class="scrollbar overflow-y-auto px-6 pb-1">

    <div class="overflow-x-auto scrollbar">
      <div class="grid grid-cols-3 gap-4 min-w-max">
        <div class="main-box-small dashboard-status">
          <div class="flex justify-start gap-4">
            <div class="w-16 h-16 bg-red-color-25 p-2 flex justify-center items-center rounded-lg border border-red-color">
