<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    <% title = 'مدیریت بدهی و طلب' %>
  </title>
  <style>
    .scrollable-table-container {
      overflow: auto;
      height: 53%;
    }

    .main-box {
      height: 45vh !important;
    }
  </style>
</head>

<body class="bg-main-color overflow-hidden">

  <%- include('partials/header') %>

  <section class="scrollbar overflow-y-auto px-6 pb-1">

    <h3 class="font-bold text-zinc-950 text-center">مدیریت بدهی و طلب</h3>

    <div class="overflow-x-auto scrollbar my-2">
      <div class="grid grid-cols-3 gap-4 min-w-max">
        <div class="main-box-small dashboard-status">
          <div class="flex justify-start gap-4">
            <div class="w-16 h-16 bg-red-color-25 p-2 flex justify-center items-center rounded-lg border border-red-color">
              <svg width="39" height="39" viewBox="0 0 39 39" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M15.4375 22.3438C15.4375 23.92 16.6563 25.1875 18.1513 25.1875H21.2062C22.5062 25.1875 23.5625 24.0825 23.5625 22.7013C23.5625 21.2225 22.9125 20.6863 21.9538 20.345L17.0625 18.6388C16.1038 18.2975 15.4538 17.7775 15.4538 16.2825C15.4538 14.9175 16.51 13.7963 17.81 13.7963H20.865C22.36 13.7963 23.5788 15.0638 23.5788 16.64" stroke="var(--color-red-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M19.5 12.1875V26.8125" stroke="var(--color-red-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M35.75 19.5C35.75 28.47 28.47 35.75 19.5 35.75C10.53 35.75 3.25 28.47 3.25 19.5C3.25 10.53 10.53 3.25 19.5 3.25" stroke="var(--color-red-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M35.75 9.75V3.25H29.25" stroke="var(--color-red-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M27.625 11.375L35.75 3.25" stroke="var(--color-red-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>

            </div>
            <div>
              <div class="text-zinc-700 font-bold !text-lg">بدهی من</div>
              <div id="debtsMyDebtAmount" class="text-zinc-500 !text-md text-start my-2.5">۰ تومان</div>
            </div>
          </div>
        </div>

        <div class="main-box-small dashboard-status">
          <div class="flex justify-start gap-4">
            <div class="w-16 h-16 bg-green-color-25 p-2 flex justify-center items-center rounded-lg border border-green-color">
              <svg width="39" height="39" viewBox="0 0 39 39" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M15.4375 22.3438C15.4375 23.92 16.6563 25.1875 18.1513 25.1875H21.2062C22.5062 25.1875 23.5625 24.0825 23.5625 22.7013C23.5625 21.2225 22.9125 20.6863 21.9538 20.345L17.0625 18.6388C16.1038 18.2975 15.4538 17.7775 15.4538 16.2825C15.4538 14.9175 16.51 13.7963 17.81 13.7963H20.865C22.36 13.7963 23.5788 15.0638 23.5788 16.64" stroke="var(--color-green-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M19.5 12.1875V26.8125" stroke="var(--color-green-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M35.75 19.5C35.75 28.47 28.47 35.75 19.5 35.75C10.53 35.75 3.25 28.47 3.25 19.5C3.25 10.53 10.53 3.25 19.5 3.25" stroke="var(--color-green-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M27.625 4.875V11.375H34.125" stroke="var(--color-green-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M35.75 3.25L27.625 11.375" stroke="var(--color-green-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>

            </div>
            <div>
              <div class="text-zinc-700 font-bold !text-lg">طلب از دیگران</div>
              <div id="debtsReceivableAmount" class="text-zinc-500 !text-md text-start my-2.5">۰ تومان</div>
            </div>
          </div>
        </div>

        <div class="main-box-small dashboard-status">
          <div class="flex justify-start gap-4">
            <div class="w-16 h-16 bg-main-color-25 p-2 flex justify-center items-center rounded-lg border border-main-color">
              <svg width="39" height="39" viewBox="0 0 39 39" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M14.0918 23.286C14.0918 25.3822 15.7005 27.0722 17.6993 27.0722H21.778C23.5168 27.0722 24.9305 25.5935 24.9305 23.7735C24.9305 21.791 24.0693 21.0922 22.7855 20.6372L16.2368 18.3622C14.953 17.9072 14.0918 17.2085 14.0918 15.226C14.0918 13.406 15.5055 11.9272 17.2443 11.9272H21.323C23.3218 11.9272 24.9305 13.6172 24.9305 15.7135" stroke="var(--color-main-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M19.5 9.75V29.25" stroke="var(--color-main-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M19.5 35.75C28.4746 35.75 35.75 28.4746 35.75 19.5C35.75 10.5254 28.4746 3.25 19.5 3.25C10.5254 3.25 3.25 10.5254 3.25 19.5C3.25 28.4746 10.5254 35.75 19.5 35.75Z" stroke="var(--color-main-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>

            </div>
            <div>
              <div class="text-zinc-700 font-bold !text-lg">خالص (طلب - بدهی)</div>
              <div id="debtsNetAmount" class="text-zinc-500 !text-md text-start my-2.5">۰ تومان</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ===================== لیست بدهی‌ها ===================== -->
    <div class="grid grid-cols-1 my-2">
      <div class="main-box">
        <div class="flex items-center justify-between mb-1 border-b border-gray-200 pb-3 flex-wrap gap-2">
          <div class="flex items-center gap-3 w-full justify-between">
            <h2 class="font-bold text-lg text-zinc-800">لیست بدهی ها</h2>
            <div class="flex items-center gap-3">
              <button class="main-btn" onclick="DebtsApp.openAddModal('debt')">ثبت بدهی جدید</button>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-6 gap-4 py-4 bg-white">
          <!-- Search -->
          <div class="relative">
            <input type="text" id="debtSearchInput" placeholder="جست و جو" class="w-full h-10 border border-main-color rounded-lg pr-4 pl-4 outline-none">
            <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-6 h-6 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m20 20-3.5-3.5"></path>
            </svg>
          </div>

          <!-- وضعیت -->
          <div id="debtStatusFilter" class="custom-select relative">
            <button type="button" class="select-btn w-full h-10 border border-main-color rounded-lg flex items-center justify-between px-4 bg-white">
              <span class="selected-value text-gray-700" data-placeholder="وضعیت">وضعیت</span>
              <svg class="w-5 h-5 transition" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </button>
            <div class="dropdown hidden absolute left-0 w-full bg-white rounded-lg shadow-lg z-50">
              <div class="p-2 border-b border-main-color-25">
                <input type="text" class="search-input w-full border border-main-color-25 rounded-md px-3 py-2 outline-none" placeholder="جستجو...">
              </div>
              <div class="options max-h-52 overflow-y-auto">
                <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100" data-value="">همه</div>
                <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100" data-value="unpaid">پرداخت نشده</div>
                <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100" data-value="paid">پرداخت شده</div>
                <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100" data-value="overdue">سررسید گذشته</div>
              </div>
            </div>
          </div>

          <!-- تاریخ -->
          <div class="relative">
            <input type="text" id="debtDateFromPicker" class="date w-full h-10 date-none-txt wt-datepicker-input-element border border-main-color rounded-lg pr-4 pl-4 outline-none pwt-datepicker-input-element" placeholder="از تاریخ" autocomplete="off">
            <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-6 h-6 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <rect x="3" y="4" width="18" height="18" rx="2"></rect>
              <path d="M16 2v4M8 2v4M3 10h18"></path>
            </svg>
          </div>

          <div class="relative">
            <input type="text" id="debtDateToPicker" class="date w-full h-10 date-none-txt wt-datepicker-input-element border border-main-color rounded-lg pr-4 pl-4 outline-none pwt-datepicker-input-element" placeholder="تا تاریخ" autocomplete="off">
            <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-6 h-6 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <rect x="3" y="4" width="18" height="18" rx="2"></rect>
              <path d="M16 2v4M8 2v4M3 10h18"></path>
            </svg>
          </div>

          <div class="col-span-2">
            <div class="flex w-full justify-end">
              <button type="button" onclick="DebtsApp.resetFilter('debt')" class="px-4 py-2 rounded-lg border border-gray-300 text-gray-700">بازنشانی</button>
            </div>
          </div>
        </div>

        <div id="debtFormError" class="hidden mb-3 rounded-lg px-4 py-2.5 text-sm bg-red-color-25 text-red-color"></div>

        <div class="scrollable-table-container relative scrollbar border-gray-200 border rounded-md">
          <table class="w-full text-sm md:text-base">
            <thead class="bg-blue-50 shadow-sm">
              <tr>
                <th scope="col" class="sticky top-0 z-20 font-semibold text-gray-700 text-sm md:text-base bg-blue-50 backdrop-blur-sm">
                  <div class="flex items-center justify-between gap-2"><span> طرف حساب</span></div>
                </th>
                <th scope="col" class="sticky top-0 z-20 font-semibold text-gray-700 text-sm md:text-base bg-blue-50 backdrop-blur-sm">
                  <div class="flex items-center gap-1.5"><span> مبلغ</span></div>
                </th>
                <th scope="col" class="sticky top-0 z-20 font-semibold text-gray-700 text-sm md:text-base bg-blue-50 backdrop-blur-sm">
                  <div class="flex items-center gap-1.5"><span> تاریخ سررسید</span></div>
                </th>
                <th scope="col" class="sticky top-0 z-20 font-semibold text-gray-700 text-sm md:text-base bg-blue-50 backdrop-blur-sm">
                  <div class="flex items-center gap-1.5"><span> روز های باقی مانده</span></div>
                </th>
                <th scope="col" class="sticky top-0 z-20 font-semibold text-gray-700 text-sm md:text-base bg-blue-50 backdrop-blur-sm">
                  <div class="flex items-center justify-between gap-2"><span>وضعیت</span></div>
                </th>
                <th scope="col" class="sticky top-0 z-20 font-semibold text-gray-700 text-sm md:text-base bg-blue-50 backdrop-blur-sm">
                  <div class="flex items-center justify-between gap-2"><span> عملیات</span></div>
                </th>
              </tr>
            </thead>
            <tbody id="debtsTableBody" class="bg-white divide-y divide-gray-100">
              <tr>
                <td colspan="6" class="px-5 py-6 text-center text-gray-400">در حال بارگذاری بدهی‌ها...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- ===================== لیست طلب‌ها ===================== -->
    <div class="grid grid-cols-1 my-2">
      <div class="main-box">
        <div class="flex items-center justify-between mb-1 border-b border-gray-200 pb-3 flex-wrap gap-2">
          <div class="flex items-center gap-3 w-full justify-between">
            <h2 class="font-bold text-lg text-zinc-800">لیست طلب ها</h2>
            <div class="flex items-center gap-3">
              <button class="main-btn" onclick="DebtsApp.openAddModal('receivable')">ثبت طلب جدید</button>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-6 gap-4 py-4 bg-white">
          <!-- Search -->
          <div class="relative">
            <input type="text" id="demandSearchInput" placeholder="جست و جو" class="w-full h-10 border border-main-color rounded-lg pr-4 pl-4 outline-none">
            <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-6 h-6 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m20 20-3.5-3.5"></path>
            </svg>
          </div>

          <!-- وضعیت -->
          <div id="demandStatusFilter" class="custom-select relative">
            <button type="button" class="select-btn w-full h-10 border border-main-color rounded-lg flex items-center justify-between px-4 bg-white">
              <span class="selected-value text-gray-700" data-placeholder="وضعیت">وضعیت</span>
              <svg class="w-5 h-5 transition" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </button>
            <div class="dropdown absolute left-0 w-full bg-white rounded-lg shadow-lg z-50 hidden">
              <div class="p-2 border-b border-main-color-25">
                <input type="text" class="search-input w-full border border-main-color-25 rounded-md px-3 py-2 outline-none" placeholder="جستجو...">
              </div>
              <div class="options max-h-52 overflow-y-auto">
                <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100" data-value="">همه</div>
                <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100" data-value="unpaid">وصول نشده</div>
                <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100" data-value="paid">پرداخت شده</div>
                <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100" data-value="overdue">سررسید گذشته</div>
              </div>
            </div>
          </div>

          <!-- تاریخ -->
          <div class="relative">
            <input type="text" id="demandDateFromPicker" class="date w-full h-10 date-none-txt wt-datepicker-input-element border border-main-color rounded-lg pr-4 pl-4 outline-none pwt-datepicker-input-element" placeholder="از تاریخ" autocomplete="off">
            <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-6 h-6 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <rect x="3" y="4" width="18" height="18" rx="2"></rect>
              <path d="M16 2v4M8 2v4M3 10h18"></path>
            </svg>
          </div>

          <div class="relative">
            <input type="text" id="demandDateToPicker" class="date w-full h-10 date-none-txt wt-datepicker-input-element border border-main-color rounded-lg pr-4 pl-4 outline-none pwt-datepicker-input-element" placeholder="تا تاریخ" autocomplete="off">
            <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-6 h-6 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <rect x="3" y="4" width="18" height="18" rx="2"></rect>
              <path d="M16 2v4M8 2v4M3 10h18"></path>
            </svg>
          </div>

          <div class="col-span-2">
            <div class="flex w-full justify-end">
              <button type="button" onclick="DebtsApp.resetFilter('receivable')" class="px-4 py-2 rounded-lg border border-gray-300 text-gray-700">بازنشانی</button>
            </div>
          </div>
        </div>

        <div id="demandFormError" class="hidden mb-3 rounded-lg px-4 py-2.5 text-sm bg-red-color-25 text-red-color"></div>

        <div class="scrollable-table-container relative scrollbar border-gray-200 border rounded-md">
          <table class="w-full text-sm md:text-base">
            <thead class="bg-blue-50 shadow-sm">
              <tr>
                <th scope="col" class="sticky top-0 z-20 font-semibold text-gray-700 text-sm md:text-base bg-blue-50 backdrop-blur-sm">
                  <div class="flex items-center justify-between gap-2"><span> طرف حساب</span></div>
                </th>
                <th scope="col" class="sticky top-0 z-20 font-semibold text-gray-700 text-sm md:text-base bg-blue-50 backdrop-blur-sm">
                  <div class="flex items-center gap-1.5"><span> مبلغ</span></div>
                </th>
                <th scope="col" class="sticky top-0 z-20 font-semibold text-gray-700 text-sm md:text-base bg-blue-50 backdrop-blur-sm">
                  <div class="flex items-center gap-1.5"><span> تاریخ سررسید</span></div>
                </th>
                <th scope="col" class="sticky top-0 z-20 font-semibold text-gray-700 text-sm md:text-base bg-blue-50 backdrop-blur-sm">
                  <div class="flex items-center gap-1.5"><span> روز های باقی مانده</span></div>
                </th>
                <th scope="col" class="sticky top-0 z-20 font-semibold text-gray-700 text-sm md:text-base bg-blue-50 backdrop-blur-sm">
                  <div class="flex items-center justify-between gap-2"><span>وضعیت</span></div>
                </th>
                <th scope="col" class="sticky top-0 z-20 font-semibold text-gray-700 text-sm md:text-base bg-blue-50 backdrop-blur-sm">
                  <div class="flex items-center justify-between gap-2"><span> عملیات</span></div>
                </th>
              </tr>
            </thead>
            <tbody id="demandsTableBody" class="bg-white divide-y divide-gray-100">
              <tr>
                <td colspan="6" class="px-5 py-6 text-center text-gray-400">در حال بارگذاری طلب‌ها...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <div id="modalOverlay" class="hidden fixed inset-0 bg-black/60 z-40" onclick="closeModal()"></div>

  <!-- مودال ثبت/ویرایش بدهی (مشترک) -->
  <div id="debtModal" class="modal hidden fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-xl max-w-2xl max-h-[90vh] lg:w-[30vw] w-full flex flex-col relative">
      <div class="flex items-center justify-between px-6 pt-6 pb-3 border-b border-gray-200">
        <h3 id="debtModalTitle" class="font-bold text-lg text-zinc-800">ثبت بدهی جدید</h3>
        <button type="button" onclick="closeModal()" class="text-gray-500 hover:text-gray-700">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 6L6 18M6 6l12 12" />
          </svg>
        </button>
      </div>

      <form id="debtForm" class="flex flex-col flex-1 min-h-0">
        <div class="modal-body overflow-y-auto flex-1 flex flex-col gap-3 scrollbar px-6 py-4">
          <input type="hidden" id="debtId" value="">

          <div id="debtModalFormError" class="hidden rounded-lg px-4 py-2.5 text-sm bg-red-color-25 text-red-color"></div>

          <div class="relative">
            <input type="text" id="debtCounterpartyInput" placeholder="طرف حساب" class="w-full h-10 border border-main-color rounded-lg pr-4 pl-4 outline-none">
          </div>
          <div class="grid grid-cols-2 gap-3">

            <div class="relative">
              <input type="number" min="0" step="1" id="debtAmountInput" placeholder="مبلغ " class="w-full h-10 border border-main-color rounded-lg pr-4 pl-4 outline-none">
            </div>

            <div class="relative">
              <input type="text" id="debtDueDatePicker" class="date w-full h-10 date-none-txt wt-datepicker-input-element border border-main-color rounded-lg pr-4 pl-4 outline-none" placeholder="تاریخ سررسید" autocomplete="off">
              <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-6 h-6 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                <path d="M16 2v4M8 2v4M3 10h18"></path>
              </svg>
            </div>

            <div id="debtStatusSelect" class="custom-select relative">
              <button type="button" class="select-btn w-full h-10 border border-main-color rounded-lg flex items-center justify-between px-4 bg-white">
                <span class="selected-value text-gray-700" data-placeholder="وضعیت">وضعیت</span>
                <svg class="w-5 h-5 transition" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="m6 9 6 6 6-6"></path>
                </svg>
              </button>
              <div class="dropdown hidden absolute left-0 w-full bg-white rounded-lg shadow-lg z-50">
                <div class="p-2 border-b border-main-color-25">
                  <input type="text" class="search-input w-full border border-main-color-25 rounded-md px-3 py-2 outline-none" placeholder="جستجو...">
                </div>
                <div class="options max-h-52 overflow-y-auto">
                  <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100" data-value="unpaid">پرداخت نشده</div>
                  <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100" data-value="paid">پرداخت شده</div>
                </div>
              </div>
            </div>

            <div>
              <label class="reminder-toggle">
                <input type="checkbox" id="debtReminderInput">
                <span class="slider-track"></span>
                <span class="toggle-label"> یادآور</span>
              </label>
            </div>
          </div>
        </div>

        <div class="flex justify-end gap-2 px-6 pb-6 pt-4 border-t border-gray-200">
          <button type="button" onclick="closeModal()" class="px-4 py-2 rounded-lg border border-gray-300 text-gray-700">انصراف</button>
          <button type="submit" id="debtSubmitBtn" class="main-btn px-4 py-2 rounded-lg">ثبت</button>
        </div>
      </form>
    </div>
  </div>

  <!-- مودال ثبت/ویرایش طلب (مشترک) -->
  <div id="demandModal" class="modal hidden fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-xl max-w-2xl max-h-[90vh] lg:w-[30vw] w-full flex flex-col relative">
      <div class="flex items-center justify-between px-6 pt-6 pb-3 border-b border-gray-200">
        <h3 id="demandModalTitle" class="font-bold text-lg text-zinc-800">ثبت طلب جدید</h3>
        <button type="button" onclick="closeModal()" class="text-gray-500 hover:text-gray-700">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 6L6 18M6 6l12 12" />
          </svg>
        </button>
      </div>

      <form id="demandForm" class="flex flex-col flex-1 min-h-0">
        <div class="modal-body overflow-y-auto flex-1 flex flex-col gap-3 scrollbar px-6 py-4">
          <input type="hidden" id="demandId" value="">

          <div id="demandModalFormError" class="hidden rounded-lg px-4 py-2.5 text-sm bg-red-color-25 text-red-color"></div>

          <div class="relative">
            <input type="text" id="demandCounterpartyInput" placeholder="طرف حساب" class="w-full h-10 border border-main-color rounded-lg pr-4 pl-4 outline-none">
          </div>
          <div class="grid grid-cols-2 gap-3">

            <div class="relative">
              <input type="number" min="0" step="1" id="demandAmountInput" placeholder="مبلغ " class="w-full h-10 border border-main-color rounded-lg pr-4 pl-4 outline-none">
            </div>

            <div class="relative">
              <input type="text" id="demandDueDatePicker" class="date w-full h-10 date-none-txt wt-datepicker-input-element border border-main-color rounded-lg pr-4 pl-4 outline-none" placeholder="تاریخ سررسید" autocomplete="off">
              <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-6 h-6 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                <path d="M16 2v4M8 2v4M3 10h18"></path>
              </svg>
            </div>

            <div id="demandStatusSelect" class="custom-select relative">
              <button type="button" class="select-btn w-full h-10 border border-main-color rounded-lg flex items-center justify-between px-4 bg-white">
                <span class="selected-value text-gray-700" data-placeholder="وضعیت">وضعیت</span>
                <svg class="w-5 h-5 transition" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="m6 9 6 6 6-6"></path>
                </svg>
              </button>
              <div class="dropdown hidden absolute left-0 w-full bg-white rounded-lg shadow-lg z-50">
                <div class="p-2 border-b border-main-color-25">
                  <input type="text" class="search-input w-full border border-main-color-25 rounded-md px-3 py-2 outline-none" placeholder="جستجو...">
                </div>
                <div class="options max-h-52 overflow-y-auto">
                  <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100" data-value="unpaid">وصول نشده</div>
                  <div class="option px-4 py-3 cursor-pointer hover:bg-gray-100" data-value="paid">پرداخت شده</div>
                </div>
              </div>
            </div>

            <div>
              <label class="reminder-toggle">
                <input type="checkbox" id="demandReminderInput">
                <span class="slider-track"></span>
                <span class="toggle-label"> یادآور</span>
              </label>
            </div>
          </div>
        </div>

        <div class="flex justify-end gap-2 px-6 pb-6 pt-4 border-t border-gray-200">
          <button type="button" onclick="closeModal()" class="px-4 py-2 rounded-lg border border-gray-300 text-gray-700">انصراف</button>
          <button type="submit" id="demandSubmitBtn" class="main-btn px-4 py-2 rounded-lg">ثبت</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function openModal(id) {
      document.getElementById('modalOverlay').classList.remove('hidden');
      document.getElementById(id).classList.remove('hidden');
      document.body.classList.add('overflow-hidden');
    }

    function closeModal() {
      document.querySelectorAll('.modal').forEach(m => m.classList.add('hidden'));
      document.getElementById('modalOverlay').classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
    }
  </script>
  <script src="/JS/debts.js" defer></script>
</body>

</html>
